# HR Reserve System - Environment Configuration Example
# Copy this file to .env and configure real credentials for production

# ---------------------------------------------
# Database Configuration
# ---------------------------------------------
# Database__Provider: "PostgreSQL" or "SQLite"
Database__Provider=PostgreSQL

# Connection string for PostgreSQL or SQLite
ConnectionStrings__DefaultConnection="Host=db;Port=5432;Database=hrreserve;Username=hruser;Password=ChangeThisStrongPostgresPassword123!"

# ---------------------------------------------
# ASP.NET Core Runtime Settings
# ---------------------------------------------
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080
HRRESERVE_USE_HTTPS_REDIRECTION=false

# ---------------------------------------------
# S3 / MinIO Object Storage (Optional)
# ---------------------------------------------
# If Enabled=false, local storage at App_Data/Storage/Resumes is used
Storage__Provider=Local
Storage__S3__Enabled=false
Storage__S3__ServiceUrl=http://minio:9000
Storage__S3__BucketName=hrreservesystem
Storage__S3__AccessKey=minioadmin
Storage__S3__SecretKey=minioadmin123
Storage__S3__ForcePathStyle=true

# ---------------------------------------------
# SMTP Email & Notifications (Optional)
# ---------------------------------------------
Email__Enabled=false
Email__Host=smtp.example.com
Email__Port=587
Email__UseSsl=true
Email__UserName=hr@example.com
Email__Password=SuperSecretSmtpPassword
Email__FromEmail=no-reply@hrreservesystem.duckdns.org
Email__FromName="HR Reserve System"
Email__RedirectAllTo=
