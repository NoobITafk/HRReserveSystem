@model HRReserveSystem.Models.Application

@{
    ViewData["Title"] = "Заявку успішно прийнято — Кар'єрний портал";
}

<div class="container py-5 text-center" style="max-width: 680px;">
    <div class="card p-5 bg-surface border shadow-sm">
        <div class="mb-4">
            <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-emerald-subtle text-emerald" style="width: 72px; height: 72px;">
                <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            </span>
        </div>

        <span class="badge-soft badge-soft-emerald px-3 py-1 text-uppercase fw-bold mb-2 align-self-center" style="font-size:0.75rem;">Заявка зареєстрована</span>
        <h1 class="h2 fw-bold mb-3">Дякуємо за ваш відгук!</h1>
        <p class="text-muted mb-4 lead" style="font-size: 1.05rem;">
            Ми успішно отримали вашу заявку на вакансію <strong>«@(Model.Vacancy?.Title ?? "відкриту позицію")»</strong>.
            Наша команда рекрутингу вже отримала сповіщення та зв'яжеться з вами протягом 24–48 робочих годин.
        </p>

        <div class="p-3 bg-surface-muted border rounded-3 mb-4 text-start small">
            <div class="d-flex justify-content-between mb-2">
                <span class="text-muted">Кандидат:</span>
                <span class="fw-semibold">@(Model.Candidate?.FullName ?? "Кандидат")</span>
            </div>
            <div class="d-flex justify-content-between mb-2">
                <span class="text-muted">Електронна пошта:</span>
                <span class="fw-semibold">@(Model.Candidate?.Email ?? "—")</span>
            </div>
            <div class="d-flex justify-content-between mb-2">
                <span class="text-muted">Вакансія:</span>
                <span class="fw-semibold">@(Model.Vacancy?.Title ?? "—")</span>
            </div>
            <div class="d-flex justify-content-between">
                <span class="text-muted">Дата подання:</span>
                <span class="font-monospace">@Model.AppliedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
            </div>
        </div>

        <div class="d-flex justify-content-center gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">
                Переглянути інші вакансії
            </a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                На головну сторінку
            </a>
        </div>
    </div>
</div>
