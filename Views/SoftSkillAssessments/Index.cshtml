@model IEnumerable<SoftSkillAssessment>

@{
    ViewData["Title"] = "Оцінка Soft Skills";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <span class="section-eyebrow">Матриця компетенцій</span>
        <h1 class="h2 fw-bold mb-1">Оцінки Soft Skills <span class="badge-soft badge-soft-slate font-monospace ms-1">@Model.Count()</span></h1>
        <p class="text-muted mb-0">5-вимірна оцінка комунікації, командної взаємодії, відповідальності, стресостійкості та лідерства.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create"><span aria-hidden="true">+</span> Нова оцінка</a>
</div>

<div class="card">
    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Кандидат</th>
                        <th>Комунікація</th>
                        <th>Команда</th>
                        <th>Відповідальність</th>
                        <th>Стресостійкість</th>
                        <th>Лідерство</th>
                        <th>Інтегральний бал</th>
                        <th class="text-end">Дії</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr class="clickable-row" data-row-link="@Url.Action("Details", new { id = item.Id })" tabindex="0">
                        <td class="fw-semibold">@item.Candidate?.FullName</td>
                        <td><span class="score-badge font-monospace">@item.Communication</span></td>
                        <td><span class="score-badge font-monospace">@item.Teamwork</span></td>
                        <td><span class="score-badge font-monospace">@item.Responsibility</span></td>
                        <td><span class="score-badge font-monospace">@item.StressResistance</span></td>
                        <td><span class="score-badge font-monospace">@item.Leadership</span></td>
                        <td><span class="score-badge score-badge-average font-monospace">@item.AverageScore / 10</span></td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@item.Id">Деталі</a>
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@item.Id">Редагувати</a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id">Видалити</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <h2 class="h5 fw-bold">Оцінок Soft Skills ще немає</h2>
            <p class="text-muted mb-3">Додайте першу оцінку особистісних компетенцій кандидата.</p>
            <a class="btn btn-primary" asp-action="Create"><span aria-hidden="true">+</span> Додати оцінку</a>
        </div>
    }
</div>
