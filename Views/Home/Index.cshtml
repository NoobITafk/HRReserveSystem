@model HRReserveSystem.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Панель керування";

    var applicationTotal = Math.Max(1, Model.ApplicationStatusCounts.Values.Sum());
    var vacancyTotal = Math.Max(1, Model.VacancyStatusCounts.Values.Sum());
    var applicationColors = new Dictionary<string, string>
    {
        ["New"] = "#94a3b8",
        ["Screening"] = "#0d9488",
        ["Interview"] = "#f59e0b",
        ["TestTask"] = "#6366f1",
        ["Offer"] = "#34d399",
        ["Hired"] = "#047857",
        ["Rejected"] = "#f43f5e"
    };
    var vacancyColors = new Dictionary<string, string>
    {
        ["Open"] = "#10b981",
        ["Paused"] = "#f59e0b",
        ["Closed"] = "#94a3b8"
    };
    var canOpenHiringPages = User.IsInRole("Admin") || User.IsInRole("Recruiter");
    var canOpenInterviewPages = User.IsInRole("Admin") || User.IsInRole("Interviewer");
    var isAdmin = User.IsInRole("Admin");
    var candidatesUrl = canOpenHiringPages ? Url.Action("Index", "Candidates") : null;
    var vacanciesUrl = canOpenHiringPages ? Url.Action("Index", "Vacancies") : null;
    var applicationsUrl = canOpenHiringPages ? Url.Action("Index", "Applications") : null;
    var interviewsUrl = Url.Action("Index", "Interviews");
    var softSkillsUrl = canOpenInterviewPages ? Url.Action("Index", "SoftSkillAssessments") : null;
    var recruitersUrl = isAdmin ? Url.Action("Index", "Recruiters") : null;
    var acceptedUrl = canOpenHiringPages ? Url.Action("Index", "Applications", new { status = "Hired" }) : null;
    var rejectedUrl = canOpenHiringPages ? Url.Action("Index", "Applications", new { status = "Rejected" }) : null;
}

@functions {
    private static string FormatChartNumber(double value)
    {
        return value.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);
    }
}

<div class="dashboard-hero mb-4">
    <div class="dashboard-hero-copy">
        <span class="section-eyebrow">Аналітичний центр</span>
        <h1 class="h2 fw-bold mb-1">Панель кадрового резерву</h1>
        <p class="text-muted mb-0">Огляд кандидатів, відкритих позицій, воронки відбору, запланованих співбесід та оцінки Soft Skills у реальному часі.</p>
    </div>
    @if (User.IsInRole("Admin") || User.IsInRole("Recruiter"))
    {
        <div class="dashboard-actions">
            <a class="btn btn-primary" asp-controller="Candidates" asp-action="Create"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14"/><path d="M5 12h14"/></svg> Додати кандидата</a>
            <a class="btn btn-outline-primary" asp-controller="Vacancies" asp-action="Create"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14"/><path d="M5 12h14"/></svg> Нова вакансія</a>
            <a class="btn btn-outline-secondary" asp-controller="Applications" asp-action="Create"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14"/><path d="M5 12h14"/></svg> Створити заявку</a>
        </div>
    }
    else
    {
        <div class="dashboard-actions">
            <a class="btn btn-primary" asp-controller="InterviewFeedbacks" asp-action="Create"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14"/><path d="M5 12h14"/></svg> Новий відгук</a>
            <a class="btn btn-outline-secondary" asp-controller="SoftSkillAssessments" asp-action="Create"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14"/><path d="M5 12h14"/></svg> Оцінка Soft Skills</a>
        </div>
    }
</div>

<div class="dashboard-kpi-grid mb-4">
    @if (canOpenHiringPages)
    {
        <a class="card dashboard-card dashboard-card-link" href="@candidatesUrl">
            <div class="card-body">
                <div class="dashboard-card-head">
                    <span class="dashboard-icon dashboard-icon-blue" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm7 8a7 7 0 0 0-14 0" /></svg></span>
                    <span class="text-muted small text-uppercase">Кандидати в резерві</span>
                </div>
                <div class="display-6 fw-bold font-monospace">@Model.CandidateCount</div>
                @{ var candSign = Model.CandidateDelta >= 0 ? "↗" : "↘"; var candClass = Model.CandidateDelta >= 0 ? "text-success" : "text-danger"; var candAbs = Math.Abs(Model.CandidateDelta); }
                <div class="metric-delta @candClass">@candSign @((candAbs == 0) ? "0" : (Model.CandidateDelta > 0 ? "+" + candAbs : "-" + candAbs)) за 7 днів</div>
            </div>
        </a>
        <a class="card dashboard-card dashboard-card-link" href="@vacanciesUrl">
            <div class="card-body">
                <div class="dashboard-card-head">
                    <span class="dashboard-icon dashboard-icon-violet" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2m-9 0h12v12H4V7h4Z" /></svg></span>
                    <span class="text-muted small text-uppercase">Вакансії</span>
                </div>
                <div class="display-6 fw-bold font-monospace">@Model.VacancyCount</div>
                @{ var vacSign = Model.VacancyDelta >= 0 ? "↗" : "↘"; var vacClass = Model.VacancyDelta >= 0 ? "text-success" : "text-danger"; var vacAbs = Math.Abs(Model.VacancyDelta); }
                <div class="metric-delta @vacClass">@vacSign @((vacAbs == 0) ? "0" : (Model.VacancyDelta > 0 ? "+" + vacAbs : "-" + vacAbs)) за 7 днів</div>
            </div>
        </a>
        <a class="card dashboard-card dashboard-card-link" href="@applicationsUrl">
            <div class="card-body">
                <div class="dashboard-card-head">
                    <span class="dashboard-icon dashboard-icon-amber" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 3h7l4 4v14H7zM14 3v5h5M9 13h6M9 17h6" /></svg></span>
                    <span class="text-muted small text-uppercase">Активні заявки</span>
                </div>
                <div class="display-6 fw-bold font-monospace">@Model.ApplicationCount</div>
                @{ var appSign = Model.ApplicationDelta >= 0 ? "↗" : "↘"; var appClass = Model.ApplicationDelta >= 0 ? "text-success" : "text-danger"; var appAbs = Math.Abs(Model.ApplicationDelta); }
                <div class="metric-delta @appClass">@appSign @((appAbs == 0) ? "0" : (Model.ApplicationDelta > 0 ? "+" + appAbs : "-" + appAbs)) за 7 днів</div>
            </div>
        </a>
    }
    <a class="card dashboard-card dashboard-card-link" href="@interviewsUrl">
        <div class="card-body">
            <div class="dashboard-card-head">
                <span class="dashboard-icon dashboard-icon-cyan" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 5h14v10H8l-3 4V5Z" /></svg></span>
                <span class="text-muted small text-uppercase">Співбесіди</span>
            </div>
            <div class="display-6 fw-bold font-monospace">@Model.InterviewCount</div>
            @{ var intSign = Model.InterviewDelta >= 0 ? "↗" : "↘"; var intClass = Model.InterviewDelta >= 0 ? "text-success" : "text-danger"; var intAbs = Math.Abs(Model.InterviewDelta); }
            <div class="metric-delta @intClass">@intSign @((intAbs == 0) ? "0" : (Model.InterviewDelta > 0 ? "+" + intAbs : "-" + intAbs)) за 7 днів</div>
        </div>
    </a>
    @if (canOpenInterviewPages)
    {
        <a class="card dashboard-card dashboard-card-link" href="@softSkillsUrl">
            <div class="card-body">
                <div class="dashboard-card-head">
                    <span class="dashboard-icon dashboard-icon-success" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m12 3 2.7 5.5 6.1.9-4.4 4.3 1 6-5.4-2.9-5.4 2.9 1-6-4.4-4.3 6.1-.9z" /></svg></span>
                    <span class="text-muted small text-uppercase">Soft Skills</span>
                </div>
                <div class="display-6 fw-bold font-monospace">@Model.AverageSoftSkillScore</div>
                <div class="metric-delta text-muted">Середній бал з 10</div>
            </div>
        </a>
    }
    @if (isAdmin)
    {
        <a class="card dashboard-card dashboard-card-link" href="@recruitersUrl">
            <div class="card-body">
                <div class="dashboard-card-head">
                    <span class="dashboard-icon dashboard-icon-violet" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M9 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm6-1a3 3 0 1 0 0-6M3 20a6 6 0 0 1 12 0m3 0a6 6 0 0 0-3-5.2" /></svg></span>
                    <span class="text-muted small text-uppercase">Команда</span>
                </div>
                <div class="display-6 fw-bold font-monospace">@Model.RecruiterCount</div>
                <div class="metric-delta text-muted">Активні учасники</div>
            </div>
        </a>
    }
    @if (!canOpenHiringPages)
    {
        <a class="card dashboard-card dashboard-card-link" href="@Url.Action("Index", "InterviewFeedbacks")">
            <div class="card-body">
                <div class="dashboard-card-head">
                    <span class="dashboard-icon dashboard-icon-amber" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><path d="m9 15 2 2 4-4"/></svg></span>
                    <span class="text-muted small text-uppercase">Надано відгуків</span>
                </div>
                <div class="display-6 fw-bold font-monospace">@Model.FeedbackCount</div>
                <div class="metric-delta text-muted">Експертні оцінки</div>
            </div>
        </a>
        <a class="card dashboard-card dashboard-card-link" href="@Url.Action("Calendar", "Interviews")">
            <div class="card-body">
                <div class="dashboard-card-head">
                    <span class="dashboard-icon dashboard-icon-blue" aria-hidden="true"><svg viewBox="0 0 24 24"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg></span>
                    <span class="text-muted small text-uppercase">Календар</span>
                </div>
                <div class="display-6 fw-bold font-monospace">Live</div>
                <div class="metric-delta text-success">Розклад зустрічей →</div>
            </div>
        </a>
    }
    @if (canOpenHiringPages)
    {
        <a class="card dashboard-card dashboard-card-link" href="@acceptedUrl">
            <div class="card-body">
                <div class="dashboard-card-head">
                    <span class="dashboard-icon dashboard-icon-success" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m5 12 4 4L19 6" /></svg></span>
                    <span class="text-muted small text-uppercase">Прийняті</span>
                </div>
                <div class="display-6 fw-bold font-monospace">@Model.AcceptedCandidateCount</div>
                @{ var accSign = Model.AcceptedDelta >= 0 ? "↗" : "↘"; var accClass = Model.AcceptedDelta >= 0 ? "text-success" : "text-danger"; var accAbs = Math.Abs(Model.AcceptedDelta); }
                <div class="metric-delta @accClass">@accSign @((accAbs == 0) ? "0" : (Model.AcceptedDelta > 0 ? "+" + accAbs : "-" + accAbs)) за 7 днів</div>
            </div>
        </a>
        <a class="card dashboard-card dashboard-card-link" href="@rejectedUrl">
            <div class="card-body">
                <div class="dashboard-card-head">
                    <span class="dashboard-icon dashboard-icon-danger" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m6 6 12 12M18 6 6 18" /></svg></span>
                    <span class="text-muted small text-uppercase">Відхилені</span>
                </div>
                <div class="display-6 fw-bold font-monospace">@Model.RejectedCandidateCount</div>
                @{ var rejSign = Model.RejectedDelta >= 0 ? "↗" : "↘"; var rejClass = Model.RejectedDelta >= 0 ? "text-success" : "text-danger"; var rejAbs = Math.Abs(Model.RejectedDelta); }
                <div class="metric-delta @rejClass">@rejSign @((rejAbs == 0) ? "0" : (Model.RejectedDelta > 0 ? "+" + rejAbs : "-" + rejAbs)) за 7 днів</div>
            </div>
        </a>
    }
</div>

<div class="dashboard-bento-grid">
@if (!canOpenHiringPages)
{
    <!-- Interviewer: Upcoming / Recent Interviews -->
    <section class="card bento-card" style="grid-column: span 6;">
        <div class="card-header">
            <div>
                <h2 class="h5 mb-0">Призначені співбесіди</h2>
                <small class="text-muted">Актуальні зустрічі з кандидатами</small>
            </div>
            <a class="btn btn-sm btn-outline-secondary" asp-controller="Interviews" asp-action="Calendar">Календар →</a>
        </div>
        <div class="card-body">
            @if (Model.UpcomingInterviews.Any())
            {
                <div class="interview-stack">
                @foreach (var interview in Model.UpcomingInterviews.Take(5))
                {
                    <a class="interview-item" asp-controller="Interviews" asp-action="Details" asp-route-id="@interview.Id">
                        <span class="interview-date">
                            <strong class="font-monospace">@interview.InterviewDate.Day</strong>
                            <small>@interview.InterviewDate.ToString("MMM")</small>
                        </span>
                        <span class="min-w-0">
                            <strong>@(interview.Application?.Candidate?.FullName ?? "Кандидат")</strong>
                            <small class="text-truncate d-block">@(interview.Application?.Vacancy?.Title ?? "Позиція") · @interview.InterviewDate.ToString("HH:mm")</small>
                        </span>
                        <span class="@HrOptions.InterviewResultBadge(interview.Result)">@HrOptions.InterviewResultLabel(interview.Result)</span>
                    </a>
                }
                </div>
            }
            else
            {
                <div class="empty-state">Запланованих співбесід немає.</div>
            }
        </div>
    </section>

    <!-- Interviewer: Recent Feedbacks -->
    <section class="card bento-card" style="grid-column: span 6;">
        <div class="card-header">
            <div>
                <h2 class="h5 mb-0">Останні експертні відгуки</h2>
                <small class="text-muted">Оцінки інтерв'юерів за співбесідами</small>
            </div>
            <a class="btn btn-sm btn-outline-secondary" asp-controller="InterviewFeedbacks" asp-action="Index">Усі відгуки →</a>
        </div>
        <div class="card-body">
            @if (Model.RecentFeedbacks.Any())
            {
                <div class="d-flex flex-column gap-2">
                @foreach (var fb in Model.RecentFeedbacks.Take(4))
                {
                    <a class="p-3 rounded-2 surface-subtle border text-decoration-none d-block transition-all" asp-controller="InterviewFeedbacks" asp-action="Details" asp-route-id="@fb.Id">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <strong>@(fb.Interview?.Application?.Candidate?.FullName ?? "Кандидат")</strong>
                            <span class="badge-soft badge-soft-emerald font-monospace fw-bold">Бал: @fb.Score / 10</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center text-muted small">
                            <span>@(fb.Interview?.Application?.Vacancy?.Title ?? "Вакансія")</span>
                            <span class="@HrOptions.FeedbackRecommendationBadge(fb.Recommendation)">@HrOptions.FeedbackRecommendationLabel(fb.Recommendation)</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(fb.Comment))
                        {
                            <p class="text-muted small text-truncate mb-0 mt-1">@fb.Comment</p>
                        }
                    </a>
                }
                </div>
            }
            else
            {
                <div class="empty-state">Відгуків ще немає. Створіть перший відгук після проведення інтерв'ю.</div>
            }
        </div>
    </section>

    <!-- Interviewer: Recent Soft Skills -->
    <section class="card bento-card" style="grid-column: span 7;">
        <div class="card-header">
            <div>
                <h2 class="h5 mb-0">Матриця оцінок Soft Skills</h2>
                <small class="text-muted">Нещодавно оцінені кандидати кадрового резерву</small>
            </div>
            <a class="btn btn-sm btn-outline-secondary" asp-controller="SoftSkillAssessments" asp-action="Index">Всі оцінки →</a>
        </div>
        <div class="card-body">
            @if (Model.RecentSoftSkillAssessments.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Кандидат</th>
                                <th>Середній бал</th>
                                <th>Комунікація</th>
                                <th>Команда</th>
                                <th>Лідерство</th>
                                <th class="text-end">Дія</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var s in Model.RecentSoftSkillAssessments)
                        {
                            <tr>
                                <td class="fw-semibold">@(s.Candidate?.FullName ?? "Кандидат")</td>
                                <td>
                                    <span class="badge-soft badge-soft-emerald font-monospace fw-bold">@s.AverageScore.ToString("F1") / 10</span>
                                </td>
                                <td class="font-monospace small">@s.Communication/10</td>
                                <td class="font-monospace small">@s.Teamwork/10</td>
                                <td class="font-monospace small">@s.Leadership/10</td>
                                <td class="text-end">
                                    <a class="btn btn-sm btn-outline-primary" asp-controller="SoftSkillAssessments" asp-action="Details" asp-route-id="@s.Id">Аналітика</a>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state">Оцінок Soft Skills ще немає.</div>
            }
        </div>
    </section>

    <!-- Interviewer: Quick Actions & Guide -->
    <section class="card bento-card" style="grid-column: span 5;">
        <div class="card-header">
            <h2 class="h5 mb-0">Швидкі дії інтерв'юера</h2>
        </div>
        <div class="card-body d-flex flex-column gap-3">
            <div class="d-grid gap-2">
                <a class="btn btn-primary" asp-controller="InterviewFeedbacks" asp-action="Create">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
                    Залишити новий відгук
                </a>
                <a class="btn btn-outline-primary" asp-controller="SoftSkillAssessments" asp-action="Create">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                    Оцінити Soft Skills кандидата
                </a>
                <a class="btn btn-outline-secondary" asp-controller="Interviews" asp-action="Calendar">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                    Інтерактивний календар зустрічей
                </a>
            </div>
            <div class="p-3 rounded-3 surface-subtle border mt-auto">
                <div class="fw-semibold small text-emerald mb-1">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" class="me-1"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
                    Критерії оцінювання:
                </div>
                <div class="text-muted small" style="line-height: 1.4;">
                    Виставляйте бали за 10-бальною шкалою, фіксуючи технічний рівень, комунікацію, командну взаємодію та чіткі рекомендації (Hire / Maybe / Reject).
                </div>
            </div>
        </div>
    </section>
}
else
{

        <section class="card bento-card bento-card-wide">
            <div class="card-header">
                <div>
                    <h2 class="h5 mb-0">Воронка заявок за етапами</h2>
                    <small class="text-muted">Розподіл кандидатів по етапах рекрутингу</small>
                </div>
                <a class="btn btn-sm btn-outline-secondary" asp-controller="Applications" asp-action="Index">Усі заявки →</a>
            </div>
            <div class="card-body bento-chart-body">
                <div class="donut-chart" aria-label="Заявки за статусами">
                    <svg viewBox="0 0 100 100" role="img" aria-hidden="true">
                        <g class="donut-segments" transform="rotate(-90 50 50)">
                            @{
                                var applicationOffset = 0d;
                            }
                            @foreach (var status in HrOptions.ApplicationStatuses)
                            {
                                var count = Model.ApplicationStatusCounts.TryGetValue(status, out var value) ? value : 0;
                                if (count <= 0)
                                {
                                    continue;
                                }

                                var share = count * 100.0 / applicationTotal;
                                var gap = Math.Max(0, 100.0 - share);
                                var percent = (int)Math.Round(count * 100.0 / applicationTotal);
                                var statusUrl = Url.Action("Index", "Applications", new { status });
                                var label = HrOptions.ApplicationStatusLabel(status);

                                <a class="donut-segment-link" href="@statusUrl" aria-label="@($"{label}: {count} ({percent}%)")">
                                    <circle class="donut-segment"
                                            cx="50"
                                            cy="50"
                                            r="38"
                                            pathLength="100"
                                            stroke="@applicationColors[status]"
                                            stroke-dasharray="@FormatChartNumber(share) @FormatChartNumber(gap)"
                                            stroke-dashoffset="@FormatChartNumber(-applicationOffset)">
                                        <title>@label: @count (@percent%)</title>
                                    </circle>
                                </a>

                                applicationOffset += share;
                            }
                        </g>
                    </svg>
                    <span class="font-monospace">@Model.ApplicationCount</span>
                </div>
                <div class="status-legend">
                    @foreach (var status in HrOptions.ApplicationStatuses)
                    {
                        var count = Model.ApplicationStatusCounts.TryGetValue(status, out var value) ? value : 0;
                        if (count == 0)
                        {
                            continue;
                        }
                        var percent = (int)Math.Round(count * 100.0 / applicationTotal);
                        var statusUrl = Url.Action("Index", "Applications", new { status });

                        <a class="status-legend-row" href="@statusUrl">
                            <span class="legend-dot" style="background:@applicationColors[status]"></span>
                            <span>@HrOptions.ApplicationStatusLabel(status)</span>
                            <strong class="font-monospace">@count (@percent%)</strong>
                        </a>
                    }
                </div>
            </div>
        </section>

        <section class="card bento-card">
            <div class="card-header">
                <h2 class="h5 mb-0">Нові кандидати в резерві</h2>
                <a class="btn btn-sm btn-link" asp-controller="Candidates" asp-action="Index">Усі</a>
            </div>
            <div class="card-body">
                @if (Model.RecentCandidates.Any())
                {
                    <div class="stack-list">
                        @foreach (var candidate in Model.RecentCandidates.Take(4))
                        {
                            <a class="stack-list-item" asp-controller="Candidates" asp-action="Details" asp-route-id="@candidate.Id">
                                <span class="candidate-avatar">@candidate.FullName.Trim()[0]</span>
                                <span class="min-w-0">
                                    <strong>@candidate.FullName</strong>
                                    <small class="text-truncate d-block">@candidate.Email</small>
                                </span>
                                <span class="badge-soft badge-soft-blue font-monospace">@candidate.ExperienceYears р.</span>
                            </a>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state">Кандидатів ще немає.</div>
                }
            </div>
        </section>

    <section class="card bento-card">
        <div class="card-header">
            <h2 class="h5 mb-0">Найближчі співбесіди</h2>
            <a class="btn btn-sm btn-link" asp-controller="Interviews" asp-action="Calendar">Календар</a>
        </div>
        <div class="card-body">
            @if (Model.UpcomingInterviews.Any())
            {
                <div class="interview-stack">
                @foreach (var interview in Model.UpcomingInterviews.Take(4))
                {
                    <a class="interview-item" asp-controller="Interviews" asp-action="Details" asp-route-id="@interview.Id">
                        <span class="interview-date">
                            <strong class="font-monospace">@interview.InterviewDate.Day</strong>
                            <small>@interview.InterviewDate.ToString("MMM")</small>
                        </span>
                        <span class="min-w-0">
                            <strong>@interview.Application?.Candidate?.FullName</strong>
                            <small class="text-truncate d-block">@interview.Application?.Vacancy?.Title · @interview.InterviewDate.ToString("HH:mm")</small>
                        </span>
                        <span class="@HrOptions.InterviewResultBadge(interview.Result)">@HrOptions.InterviewResultLabel(interview.Result)</span>
                    </a>
                }
                </div>
            }
            else
            {
                <div class="empty-state">Запланованих співбесід немає.</div>
            }
        </div>
    </section>

    @if (canOpenHiringPages)
    {
        <section class="card bento-card">
            <div class="card-header">
                <h2 class="h5 mb-0">Статус вакансій</h2>
                <a class="btn btn-sm btn-link" asp-controller="Vacancies" asp-action="Index">Усі</a>
            </div>
            <div class="card-body bento-chart-body">
                <div class="donut-chart donut-chart-small" aria-label="Вакансії за статусами">
                    <svg viewBox="0 0 100 100" role="img" aria-hidden="true">
                        <g class="donut-segments" transform="rotate(-90 50 50)">
                            @{
                                var vacancyOffset = 0d;
                            }
                            @foreach (var status in HrOptions.VacancyStatuses)
                            {
                                var count = Model.VacancyStatusCounts.TryGetValue(status, out var value) ? value : 0;
                                if (count <= 0)
                                {
                                    continue;
                                }

                                var share = count * 100.0 / vacancyTotal;
                                var gap = Math.Max(0, 100.0 - share);
                                var percent = (int)Math.Round(count * 100.0 / vacancyTotal);
                                var statusUrl = Url.Action("Index", "Vacancies", new { status });
                                var label = HrOptions.VacancyStatusLabel(status);

                                <a class="donut-segment-link" href="@statusUrl" aria-label="@($"{label}: {count} ({percent}%)")">
                                    <circle class="donut-segment"
                                            cx="50"
                                            cy="50"
                                            r="38"
                                            pathLength="100"
                                            stroke="@vacancyColors[status]"
                                            stroke-dasharray="@FormatChartNumber(share) @FormatChartNumber(gap)"
                                            stroke-dashoffset="@FormatChartNumber(-vacancyOffset)">
                                        <title>@label: @count (@percent%)</title>
                                    </circle>
                                </a>

                                vacancyOffset += share;
                            }
                        </g>
                    </svg>
                    <span class="font-monospace">@Model.VacancyCount</span>
                </div>
                <div class="status-legend">
                    @foreach (var status in HrOptions.VacancyStatuses)
                    {
                        var count = Model.VacancyStatusCounts.TryGetValue(status, out var value) ? value : 0;
                        var percent = (int)Math.Round(count * 100.0 / vacancyTotal);
                        var statusUrl = Url.Action("Index", "Vacancies", new { status });

                        <a class="status-legend-row" href="@statusUrl">
                            <span class="legend-dot" style="background:@vacancyColors[status]"></span>
                            <span>@HrOptions.VacancyStatusLabel(status)</span>
                            <strong class="font-monospace">@count (@percent%)</strong>
                        </a>
                    }
                </div>
            </div>
        </section>

        <section class="card bento-card bento-card-vacancies">
            <div class="card-header">
                <h2 class="h5 mb-0">Актуальні вакансії</h2>
                <a class="btn btn-sm btn-link" asp-controller="Vacancies" asp-action="Index">Усі</a>
            </div>
            <div class="card-body">
                @if (Model.RecentVacancies.Any())
                {
                    <div class="stack-list">
                        @foreach (var vacancy in Model.RecentVacancies.Take(4))
                        {
                            <a class="stack-list-item" asp-controller="Vacancies" asp-action="Details" asp-route-id="@vacancy.Id">
                                <span class="vacancy-marker"></span>
                                <span class="min-w-0">
                                    <strong>@vacancy.Title</strong>
                                    <small class="font-monospace">@vacancy.SalaryMin.ToString("N0") – @vacancy.SalaryMax.ToString("N0") грн</small>
                                </span>
                                <span class="@HrOptions.VacancyStatusBadge(vacancy.Status)">@HrOptions.VacancyStatusLabel(vacancy.Status)</span>
                            </a>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state">Вакансій ще немає.</div>
                }
            </div>
        </section>
    }
}
</div>
