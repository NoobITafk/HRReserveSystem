@model IEnumerable<InterviewFeedback>

@{
    ViewData["Title"] = "Відгуки інтерв'юерів";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <span class="section-eyebrow">Експертна оцінка</span>
        <h1 class="h2 fw-bold mb-1">Відгуки після співбесід <span class="badge-soft badge-soft-slate font-monospace ms-1">@Model.Count()</span></h1>
        <p class="text-muted mb-0">Висновки, бали та рекомендації інтерв'юерів щодо найму або зарахування в кадровий резерв.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14"/><path d="M5 12h14"/></svg> Додати відгук</a>
</div>

<div class="card">
    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Кандидат</th>
                        <th>Вакансія</th>
                        <th>Інтерв'юер</th>
                        <th>Бал</th>
                        <th>Рекомендація</th>
                        <th>Коментар</th>
                        <th>Дата</th>
                        <th class="text-end">Дії</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr class="clickable-row" data-row-link="@Url.Action("Details", new { id = item.Id })" tabindex="0">
                        <td class="fw-semibold">@item.Interview?.Application?.Candidate?.FullName</td>
                        <td>@item.Interview?.Application?.Vacancy?.Title</td>
                        <td>@(item.Recruiter?.FullName ?? "Не вказано")</td>
                        <td><span class="badge-soft badge-soft-blue font-monospace">@item.Score / 10</span></td>
                        <td><span class="@HrOptions.FeedbackRecommendationBadge(item.Recommendation)">@HrOptions.FeedbackRecommendationLabel(item.Recommendation)</span></td>
                        <td class="table-comment-cell text-muted small">@item.Comment</td>
                        <td class="font-monospace small text-muted">@item.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@item.Id">Деталі</a>
                            @if (User.IsInRole("Admin") || User.IsInRole("Interviewer"))
                            {
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@item.Id">Редагувати</a>
                                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id">Видалити</a>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <h2 class="h5 fw-bold">Відгуків ще немає</h2>
            <p class="text-muted mb-3">Залиште перший відгук за результатами проведеної співбесіди.</p>
            <a class="btn btn-primary" asp-action="Create"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14"/><path d="M5 12h14"/></svg> Додати відгук</a>
        </div>
    }
</div>
