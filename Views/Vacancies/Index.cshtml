@model IEnumerable<Vacancy>

@{
    ViewData["Title"] = "Вакансії";
    var showArchived = ViewData["ShowArchived"] as bool? == true;
    var totalCount = Model.Count();
    var canManage = User.IsInRole("Admin") || User.IsInRole("Recruiter");
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <span class="section-eyebrow">Управління позиціями</span>
        <h1 class="h2 fw-bold mb-1">Вакансії компанії <span class="badge-soft badge-soft-slate font-monospace ms-1">@totalCount</span></h1>
        <p class="text-muted mb-0">Відкриті, призупинені та закриті позиції з вилкою винагороди та вимогами.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        @if (showArchived)
        {
            <a class="btn btn-outline-secondary" asp-action="Index">Активні вакансії</a>
        }
        else
        {
            <a class="btn btn-outline-secondary" asp-action="Index" asp-route-showArchived="true">Архів вакансій</a>
        }
        @if (canManage)
        {
            <a class="btn btn-primary" asp-action="Create"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14"/><path d="M5 12h14"/></svg> Додати вакансію</a>
        }
    </div>
</div>

<form asp-action="Index" method="get" class="card mb-4">
    <div class="card-body row g-3 align-items-end">
        <input type="hidden" name="showArchived" value="@showArchived.ToString().ToLowerInvariant()" />
        <div class="col-lg-6">
            <label class="form-label fw-medium" for="vacancySearch">Пошук за назвою позиції</label>
            <input id="vacancySearch" class="form-control" type="search" name="search" value="@ViewData["CurrentFilter"]" placeholder="Наприклад: .NET Developer, QA Engineer..." />
        </div>
        <div class="col-sm-6 col-lg-3">
            <label class="form-label fw-medium" for="status">Статус вакансії</label>
            <select id="status" class="form-select" name="status" asp-items="ViewBag.Statuses">
                <option value="">Усі статуси</option>
            </select>
        </div>
        <div class="col-sm-6 col-lg-3 d-flex gap-2">
            <button class="btn btn-primary flex-fill" type="submit">Фільтрувати</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Скинути</a>
        </div>
    </div>
</form>

<div class="card">
    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Позиція</th>
                        <th>Статус</th>
                        <th>Вилка винагороди</th>
                        <th>Дата публікації</th>
                        <th class="text-end">Дії</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr class="clickable-row" data-row-link="@Url.Action("Details", new { id = item.Id })" tabindex="0">
                        <td>
                            <div class="fw-semibold">@item.Title</div>
                            @if (!string.IsNullOrWhiteSpace(item.Description))
                            {
                                <small class="text-muted d-block text-truncate" style="max-width: 420px;">@item.Description</small>
                            }
                        </td>
                        <td><span class="@HrOptions.VacancyStatusBadge(item.Status)">@HrOptions.VacancyStatusLabel(item.Status)</span></td>
                        <td class="font-monospace fw-medium">@item.SalaryMin.ToString("N0") – @item.SalaryMax.ToString("N0") грн</td>
                        <td class="font-monospace small text-muted">@item.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@item.Id">Деталі</a>
                            @if (canManage)
                            {
                                @if (showArchived)
                                {
                                    <form asp-action="Restore" asp-route-id="@item.Id" method="post" class="d-inline">
                                        <button class="btn btn-sm btn-outline-success" type="submit">Відновити</button>
                                    </form>
                                }
                                else
                                {
                                    <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@item.Id">Редагувати</a>
                                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id">Архівувати</a>
                                }
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <h2 class="h5 fw-bold">Вакансії відсутні</h2>
            <p class="text-muted mb-3">@(showArchived ? "Архівних вакансій немає." : "Створіть першу вакансію, щоб розпочати відбір кандидатів.")</p>
            @if (!showArchived)
            {
                @if (canManage)
        {
            <a class="btn btn-primary" asp-action="Create"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14"/><path d="M5 12h14"/></svg> Додати вакансію</a>
        }
            }
        </div>
    }
</div>
