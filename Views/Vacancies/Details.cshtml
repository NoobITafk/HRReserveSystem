@model Vacancy

@{
    ViewData["Title"] = "Деталі вакансії";
    var isArchived = Model.IsArchived;
    var canManage = User.IsInRole("Admin") || User.IsInRole("Recruiter");
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <span class="section-eyebrow">Позиція #@Model.Id</span>
        <h1 class="h2 fw-bold mb-1 d-flex align-items-center gap-2">
            <span>@Model.Title</span>
            <span class="@HrOptions.VacancyStatusBadge(Model.Status)">@HrOptions.VacancyStatusLabel(Model.Status)</span>
            @if (isArchived)
            {
                <span class="badge-soft badge-soft-amber">Архівна вакансія</span>
            }
        </h1>
        <div class="text-muted small">Опубліковано @Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</div>
    </div>
    <div class="d-flex flex-wrap gap-2">
        @if (isArchived)
        {
            @if (canManage)
            {
                <form asp-action="Restore" asp-route-id="@Model.Id" method="post">
                    <button class="btn btn-outline-success" type="submit">Відновити</button>
                </form>
            }
            <a class="btn btn-outline-secondary" asp-action="Index" asp-route-showArchived="true"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>Назад до архіву</a>
        }
        else
        {
            @if (canManage)
            {
                <a class="btn btn-primary" asp-controller="Applications" asp-action="Create">Подати кандидата</a>
                <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.Id">Редагувати</a>
            }
            else
            {
                <a class="btn btn-primary" asp-controller="Account" asp-action="Profile">Мій профіль та резюме</a>
            }
            <a class="btn btn-outline-secondary" asp-action="Index"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>До списку вакансій</a>
        }
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header">
                <h2 class="h5 mb-0">Опис та вимоги до кандидата</h2>
            </div>
            <div class="card-body">
                <div class="mb-4">
                    <div class="small fw-semibold text-uppercase text-muted mb-2">Опис позиції</div>
                    <div class="p-3 rounded-3 surface-subtle border">
                        @(string.IsNullOrWhiteSpace(Model.Description) ? "Опис не вказано." : Model.Description)
                    </div>
                </div>
                <div>
                    <div class="small fw-semibold text-uppercase text-muted mb-2">Вимоги та стек</div>
                    <div class="p-3 rounded-3 surface-subtle border">
                        @(string.IsNullOrWhiteSpace(Model.Requirements) ? "Вимоги не вказано." : Model.Requirements)
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header">
                <h2 class="h5 mb-0">Умови та показники</h2>
            </div>
            <div class="card-body">
                <dl class="detail-list">
                    <div class="detail-row">
                        <dt>Вилка винагороди</dt>
                        <dd class="font-monospace">@Model.SalaryMin.ToString("N0") – @Model.SalaryMax.ToString("N0") грн</dd>
                    </div>
                    <div class="detail-row">
                        <dt>Поточний статус</dt>
                        <dd><span class="@HrOptions.VacancyStatusBadge(Model.Status)">@HrOptions.VacancyStatusLabel(Model.Status)</span></dd>
                    </div>
                    <div class="detail-row">
                        <dt>Подано заявок</dt>
                        <dd class="font-monospace">@Model.Applications.Count</dd>
                    </div>
                    <div class="detail-row">
                        <dt>Дата створення</dt>
                        <dd class="font-monospace">@Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</dd>
                    </div>
                </dl>
            </div>
        </div>
    </div>
</div>

@if (canManage)
{
<div class="card">
    <div class="card-header">
        <h2 class="h5 mb-0">Кандидати на цю вакансію</h2>
        <span class="badge-soft badge-soft-slate font-monospace">@Model.Applications.Count</span>
    </div>
    @if (Model.Applications.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Кандидат</th>
                        <th>Етап відбору</th>
                        <th>Дата подачі</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var application in Model.Applications)
                {
                    <tr>
                        <td class="fw-semibold">@application.Candidate?.FullName</td>
                        <td><span class="@HrOptions.ApplicationStatusBadge(application.Status)">@HrOptions.ApplicationStatusLabel(application.Status)</span></td>
                        <td class="font-monospace small">@application.AppliedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">На цю вакансію ще не подано жодного кандидата.</div>
    }
</div>
}
