@model Vacancy

@{
    ViewData["Title"] = "Нова вакансія";
}

<div class="form-card-container">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <span class="section-eyebrow">Позиції компанії</span>
            <h1 class="h2 fw-bold mb-1">Нова вакансія</h1>
            <p class="text-muted mb-0">Відкриття нової кар'єрної можливості, зазначення діапазону винагороди та вимог.</p>
        </div>
        <a class="btn btn-outline-secondary" asp-action="Index">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
            Назад до списку
        </a>
    </div>

    <div class="form-card">
        <form asp-action="Create" class="row g-3">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small col-12 mb-2"></div>
            
            <div class="col-md-8">
                <label asp-for="Title" class="form-label fw-semibold">Назва посади / спеціалізації</label>
                <input asp-for="Title" class="form-control" placeholder="Наприклад: Senior .NET Software Engineer" />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Status" class="form-label fw-semibold">Поточний статус</label>
                <select asp-for="Status" class="form-select">
                    @foreach (var status in HrOptions.VacancyStatuses)
                    {
                        <option value="@status">@HrOptions.VacancyStatusLabel(status)</option>
                    }
                </select>
                <span asp-validation-for="Status" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="SalaryMin" class="form-label fw-semibold">Мінімальна винагорода (грн)</label>
                <input asp-for="SalaryMin" class="form-control font-monospace" type="number" min="0" placeholder="40000" />
                <span asp-validation-for="SalaryMin" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="SalaryMax" class="form-label fw-semibold">Максимальна винагорода (грн)</label>
                <input asp-for="SalaryMax" class="form-control font-monospace" type="number" min="0" placeholder="80000" />
                <span asp-validation-for="SalaryMax" class="text-danger small"></span>
            </div>

            <div class="col-12">
                <label asp-for="Description" class="form-label fw-semibold">Опис ролі та обов'язків</label>
                <textarea asp-for="Description" class="form-control" rows="4" placeholder="Опишіть завдання проєкту, командний контекст, задачі та можливості розвитку..."></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <div class="col-12">
                <label asp-for="Requirements" class="form-label fw-semibold">Вимоги до кандидата</label>
                <textarea asp-for="Requirements" class="form-control" rows="4" placeholder="Необхідний досвід, ключові технології, мовні компетенції, освіта..."></textarea>
                <span asp-validation-for="Requirements" class="text-danger small"></span>
            </div>

            <div class="col-12 pt-3 border-top d-flex flex-wrap gap-2 justify-content-between align-items-center">
                <a class="btn btn-outline-secondary" asp-action="Index">Скасувати</a>
                <button type="submit" class="btn btn-primary">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                    Опублікувати вакансію
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
