@model Vacancy

@{
    ViewData["Title"] = "Архівувати вакансію";
}

<div class="form-card-container">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <span class="section-eyebrow text-warning">Керування статусом</span>
            <h1 class="h2 fw-bold mb-1">Архівувати вакансію</h1>
            <p class="text-muted mb-0">Підтвердження переведення позиції @Model.Title в архів.</p>
        </div>
        <a class="btn btn-outline-secondary" asp-action="Index">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
            Назад до списку
        </a>
    </div>

    <div class="form-card">
        <div class="alert alert-warning d-flex align-items-center gap-3 mb-4">
            <span class="badge-soft badge-soft-amber">Увага</span>
            <div>Вакансія <strong>@Model.Title</strong> буде переміщена в архів. Всі поточні заявки та історія співбесід залишаться в системі. Ви зможете відновити вакансію в будь-який момент.</div>
        </div>

        <div class="detail-list mb-4">
            <div class="detail-row">
                <dt>Позиція</dt>
                <dd class="fw-bold">@Model.Title</dd>
            </div>
            <div class="detail-row">
                <dt>Поточний статус</dt>
                <dd><span class="@HrOptions.VacancyStatusBadge(Model.Status)">@HrOptions.VacancyStatusLabel(Model.Status)</span></dd>
            </div>
            <div class="detail-row">
                <dt>Вилка винагороди</dt>
                <dd class="font-monospace">@Model.SalaryMin.ToString("N0") – @Model.SalaryMax.ToString("N0") грн</dd>
            </div>
        </div>

        <form asp-action="Delete" class="d-flex flex-wrap gap-2 justify-content-between align-items-center pt-3 border-top">
            <input type="hidden" asp-for="Id" />
            <a class="btn btn-outline-secondary" asp-action="Index">Скасувати</a>
            <button type="submit" class="btn btn-outline-danger">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.36 6.64a9 9 0 1 1-12.73 0"/><line x1="12" y1="2" x2="12" y2="12"/></svg>
                Підтвердити архівацію
            </button>
        </form>
    </div>
</div>
