@model IEnumerable<Candidate>

@{
    ViewData["Title"] = "Кандидати";
    var showHidden = ViewData["ShowHidden"] as bool? == true;
    var totalCount = Model.Count();
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <span class="section-eyebrow">Кадровий резерв</span>
        <h1 class="h2 fw-bold mb-1">База кандидатів <span class="badge-soft badge-soft-slate font-monospace ms-1">@totalCount</span></h1>
        <p class="text-muted mb-0">Управління профілями фахівців, резюме, ключовими навичками та досвідом роботи.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        @if (showHidden)
        {
            <a class="btn btn-outline-secondary" asp-action="Index">Активні кандидати</a>
        }
        else
        {
            <a class="btn btn-outline-secondary" asp-action="Index" asp-route-showHidden="true">Приховані кандидати</a>
        }
        <a class="btn btn-outline-primary" asp-action="ExportCsv" asp-route-search="@ViewData["CurrentFilter"]" asp-route-minExperience="@ViewData["MinExperience"]" title="Завантажити поточний список кандидатів у форматі CSV">
            Експорт у Excel/CSV
        </a>
        <a class="btn btn-primary" asp-action="Create"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14"/><path d="M5 12h14"/></svg> Додати кандидата</a>
    </div>
</div>

<form asp-action="Index" method="get" class="card mb-4">
    <div class="card-body row g-3 align-items-end">
        <input type="hidden" name="showHidden" value="@showHidden.ToString().ToLowerInvariant()" />
        <div class="col-lg-6">
            <label class="form-label fw-medium" for="candidateSearch">Пошук за іменем, поштою або технологіями</label>
            <input id="candidateSearch" class="form-control" type="search" name="search" value="@ViewData["CurrentFilter"]" placeholder="Наприклад: C#, SQL, Олена Коваль..." />
        </div>
        <div class="col-sm-6 col-lg-3">
            <label class="form-label fw-medium" for="minExperience">Мінімальний досвід (років)</label>
            <input id="minExperience" class="form-control font-monospace" type="number" min="0" name="minExperience" value="@ViewData["MinExperience"]" placeholder="0" />
        </div>
        <div class="col-sm-6 col-lg-3 d-flex gap-2">
            <button class="btn btn-primary flex-fill" type="submit">Фільтрувати</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Скинути</a>
        </div>
    </div>
</form>

<div class="card">
    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Фахівець</th>
                        <th>Контакти</th>
                        <th>Ключові навички</th>
                        <th>Досвід</th>
                        <th>Резюме</th>
                        <th class="text-end">Дії</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    var initial = string.IsNullOrWhiteSpace(item.FullName) ? "К" : item.FullName.Trim()[0].ToString().ToUpperInvariant();
                    <tr class="clickable-row" data-row-link="@Url.Action("Details", new { id = item.Id })" tabindex="0">
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                @if (!string.IsNullOrWhiteSpace(item.AvatarUrl))
                                {
                                    <img src="@item.AvatarUrl" alt="@item.FullName" class="profile-avatar profile-avatar-sm profile-avatar-img shadow-sm" />
                                }
                                else
                                {
                                    <span class="profile-avatar profile-avatar-sm">@initial</span>
                                }
                                <div>
                                    <div class="fw-semibold">@item.FullName</div>
                                    <small class="text-muted">Додано @item.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</small>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div>@item.Email</div>
                            <small class="text-muted font-monospace">@item.Phone</small>
                        </td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(item.Skills))
                            {
                                <div class="d-flex flex-wrap gap-1">
                                    @foreach (var skill in item.Skills.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Take(4))
                                    {
                                        <span class="badge-soft badge-soft-slate">@skill</span>
                                    }
                                </div>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td><span class="badge-soft badge-soft-blue font-monospace">@item.ExperienceYears р.</span></td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(item.ResumeFilePath))
                            {
                                <span class="badge-soft badge-soft-emerald">Прикріплено</span>
                            }
                            else
                            {
                                <span class="text-muted small">Немає файлу</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@item.Id">Досьє</a>
                            @if (showHidden)
                            {
                                <form asp-action="Restore" asp-route-id="@item.Id" method="post" class="d-inline">
                                    <button class="btn btn-sm btn-outline-success" type="submit">Відновити</button>
                                </form>
                            }
                            else
                            {
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@item.Id">Редагувати</a>
                                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id">Приховати</a>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <h2 class="h5 fw-bold">Кандидатів не знайдено</h2>
            <p class="text-muted mb-3">@(showHidden ? "Прихованих кандидатів у базі наразі немає." : "Спробуйте змінити параметри пошуку або додайте нового кандидата до кадрового резерву.")</p>
            @if (!showHidden)
            {
                <a class="btn btn-primary" asp-action="Create"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14"/><path d="M5 12h14"/></svg> Додати кандидата</a>
            }
        </div>
    }
</div>
