@model Candidate

@{
    ViewData["Title"] = "Досьє кандидата";
    var isHidden = Model.IsDeleted;
    var averageSoftSkillScore = Model.SoftSkillAssessments.Any()
        ? Math.Round(Model.SoftSkillAssessments.Average(assessment => assessment.AverageScore), 1)
        : (double?)null;
    var initial = string.IsNullOrWhiteSpace(Model.FullName) ? "К" : Model.FullName.Trim()[0].ToString().ToUpperInvariant();
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div class="d-flex align-items-center gap-3">
        @if (!string.IsNullOrWhiteSpace(Model.AvatarUrl))
        {
            <img src="@Model.AvatarUrl" alt="@Model.FullName" class="profile-avatar profile-avatar-lg profile-avatar-img shadow-sm" />
        }
        else
        {
            <div class="profile-avatar profile-avatar-lg">@initial</div>
        }
        <div>
            <span class="section-eyebrow">Досьє кандидата #@Model.Id</span>
            <h1 class="h2 fw-bold mb-1 d-flex align-items-center gap-2">
                <span>@Model.FullName</span>
                @if (isHidden)
                {
                    <span class="badge-soft badge-soft-amber">Прихований профіль</span>
                }
            </h1>
            <div class="text-muted small">@Model.Email · <span class="font-monospace">@Model.Phone</span></div>
        </div>
    </div>
    <div class="d-flex flex-wrap gap-2">
        @if (isHidden)
        {
            <form asp-action="Restore" asp-route-id="@Model.Id" method="post">
                <button class="btn btn-outline-success" type="submit">Відновити</button>
            </form>
            <a class="btn btn-outline-secondary" asp-action="Index" asp-route-showHidden="true"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>Назад до прихованих</a>
        }
        else
        {
            <a class="btn btn-primary" asp-controller="Applications" asp-action="Create">Подати на вакансію</a>
            <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.Id">Редагувати</a>
            <a class="btn btn-outline-secondary" asp-action="Index"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>До списку</a>
        }
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header">
                <h2 class="h5 mb-0">Професійний профіль</h2>
                <span class="badge-soft badge-soft-blue font-monospace">@Model.ExperienceYears р. досвіду</span>
            </div>
            <div class="card-body">
                <dl class="detail-list mb-4">
                    <div class="detail-row">
                        <dt>Електронна пошта</dt>
                        <dd>@Model.Email</dd>
                    </div>
                    <div class="detail-row">
                        <dt>Контактний телефон</dt>
                        <dd class="font-monospace">@Model.Phone</dd>
                    </div>
                    <div class="detail-row">
                        <dt>Дата додавання в резерв</dt>
                        <dd class="font-monospace">@Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</dd>
                    </div>
                    <div class="detail-row">
                        <dt>Інтегральний Soft Skills бал</dt>
                        <dd>
                            @if (averageSoftSkillScore.HasValue)
                            {
                                <span class="badge-soft badge-soft-emerald font-monospace">@averageSoftSkillScore / 10</span>
                            }
                            else
                            {
                                <span class="text-muted">Оцінку ще не додано</span>
                            }
                        </dd>
                    </div>
                </dl>

                <div class="mb-3">
                    <div class="small fw-semibold text-uppercase text-muted mb-2">Ключові навички та стек</div>
                    @if (!string.IsNullOrWhiteSpace(Model.Skills))
                    {
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var skill in Model.Skills.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                            {
                                <span class="badge-soft badge-soft-blue">@skill</span>
                            }
                        </div>
                    }
                    else
                    {
                        <span class="text-muted">Навички не вказано</span>
                    }
                </div>

                <div>
                    <div class="small fw-semibold text-uppercase text-muted mb-1">Коротке резюме (Summary)</div>
                    <div class="p-3 rounded-3 surface-subtle border">
                        @(string.IsNullOrWhiteSpace(Model.ResumeSummary) ? "Опис резюме не додано." : Model.ResumeSummary)
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header">
                <h2 class="h5 mb-0">Файл резюме (CV)</h2>
                @if (!string.IsNullOrWhiteSpace(Model.ResumeFilePath))
                {
                    <span class="badge-soft badge-soft-emerald">Завантажено</span>
                }
            </div>
            <div class="card-body d-flex flex-column justify-content-between">
                <div>
                    @if (TempData["ResumeError"] is string resumeError)
                    {
                        <div class="alert alert-danger py-2 mb-3 small">@resumeError</div>
                    }
                    @if (TempData["ResumeMessage"] is string resumeMessage)
                    {
                        <div class="alert alert-success py-2 mb-3 small">@resumeMessage</div>
                    }

                    @if (string.IsNullOrWhiteSpace(Model.ResumeFilePath))
                    {
                        <div class="p-4 rounded-3 surface-subtle border text-center mb-3">
                            <div class="text-muted mb-1">Файл резюме ще не прикріплено</div>
                            <small class="text-muted">Завантажте документ у форматі PDF, DOC або DOCX.</small>
                        </div>
                    }
                    else
                    {
                        <div class="p-3 rounded-3 surface-subtle border mb-3">
                            <div class="fw-semibold mb-1">Прикріплений документ</div>
                            <div class="text-muted small font-monospace text-truncate mb-3">@Model.ResumeFilePath</div>
                            <div class="d-flex flex-wrap gap-2">
                                <a class="btn btn-sm btn-primary" asp-action="DownloadResume" asp-route-id="@Model.Id" target="_blank" rel="noopener">Відкрити резюме</a>
                                <a class="btn btn-sm btn-outline-secondary" asp-action="DownloadResume" asp-route-id="@Model.Id">Завантажити файл</a>
                            </div>
                        </div>

                        @if (ViewBag.ParsedResume is HRReserveSystem.Services.ParsedResumeResult parsed && parsed.Success)
                        {
                            <div class="p-3 rounded-3 surface-elevated border border-emerald-subtle mb-3">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <span class="badge-soft badge-soft-emerald">Аналіз PDF резюме</span>
                                    <small class="text-muted">Розпізнано системою</small>
                                </div>
                                @if (parsed.DetectedSkills.Count > 0)
                                {
                                    <div class="mb-2">
                                        <div class="fw-semibold small text-muted text-uppercase mb-1" style="font-size: 0.72rem;">Виявлений стек:</div>
                                        <div class="d-flex flex-wrap gap-1">
                                            @foreach (var skill in parsed.DetectedSkills.Take(10))
                                            {
                                                <span class="badge-soft badge-soft-blue" style="font-size: 0.75rem;">@skill</span>
                                            }
                                        </div>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(parsed.Summary))
                                {
                                    <div class="small text-muted leading-relaxed" style="font-size: 0.82rem;">
                                        @parsed.Summary
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>

                @if (!isHidden)
                {
                    <form asp-action="UploadResume" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="pt-3 border-top">
                        <label class="form-label fw-medium small" for="resumeFileDetails">Оновити або прикріпити нове резюме</label>
                        <div class="input-group">
                            <input class="form-control" type="file" id="resumeFileDetails" name="resumeFile" accept=".pdf,.doc,.docx" />
                            <button class="btn btn-outline-primary" type="submit">Завантажити</button>
                        </div>
                        <div class="form-text">Підтримуються файли PDF, DOC, DOCX розміром до 5 MB.</div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header">
                <h2 class="h5 mb-0">Історія заявок на вакансії</h2>
                <span class="badge-soft badge-soft-slate font-monospace">@Model.Applications.Count</span>
            </div>
            @if (Model.Applications.Any())
            {
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Вакансія</th>
                                <th>Етап</th>
                                <th>Дата подачі</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var application in Model.Applications)
                        {
                            <tr>
                                <td class="fw-semibold">@application.Vacancy?.Title</td>
                                <td><span class="@HrOptions.ApplicationStatusBadge(application.Status)">@HrOptions.ApplicationStatusLabel(application.Status)</span></td>
                                <td class="font-monospace small">@application.AppliedAt.ToLocalTime().ToString("dd.MM.yyyy")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state">У кандидата ще немає поданих заявок на вакансії.</div>
            }
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header">
                <h2 class="h5 mb-0">Оцінки Soft Skills</h2>
                <span class="badge-soft badge-soft-slate font-monospace">@Model.SoftSkillAssessments.Count</span>
            </div>
            @if (Model.SoftSkillAssessments.Any())
            {
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Комунік.</th>
                                <th>Команда</th>
                                <th>Відповід.</th>
                                <th>Стрес</th>
                                <th>Лідерство</th>
                                <th>Середній</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var assessment in Model.SoftSkillAssessments)
                        {
                            <tr>
                                <td><span class="score-badge font-monospace">@assessment.Communication</span></td>
                                <td><span class="score-badge font-monospace">@assessment.Teamwork</span></td>
                                <td><span class="score-badge font-monospace">@assessment.Responsibility</span></td>
                                <td><span class="score-badge font-monospace">@assessment.StressResistance</span></td>
                                <td><span class="score-badge font-monospace">@assessment.Leadership</span></td>
                                <td><span class="score-badge score-badge-average font-monospace">@assessment.AverageScore</span></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state">Для цього кандидата ще не проводилось оцінювання Soft Skills.</div>
            }
        </div>
    </div>

    @if (ViewBag.Interviews is List<Interview> interviews && interviews.Count > 0)
    {
        <div class="col-12 mt-2">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h2 class="h5 mb-0">Історія співбесід та відгуки інтерв'юерів</h2>
                    <span class="badge-soft badge-soft-blue font-monospace">@interviews.Count співбесід</span>
                </div>
                <div class="card-body p-4">
                    <div class="d-flex flex-column gap-3">
                        @foreach (var interview in interviews)
                        {
                            <div class="p-3 rounded-3 surface-subtle border">
                                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                                    <div>
                                        <span class="badge-soft badge-soft-blue me-2">@HrOptions.InterviewTypeLabel(interview.InterviewType)</span>
                                        <strong>@(interview.Application?.Vacancy?.Title ?? "Загальна позиція")</strong>
                                    </div>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="text-muted small font-monospace">@interview.InterviewDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                                        <span class="@HrOptions.InterviewResultBadge(interview.Result)">@HrOptions.InterviewResultLabel(interview.Result)</span>
                                    </div>
                                </div>
                                @if (interview.Feedbacks.Count > 0)
                                {
                                    <div class="mt-2 pt-2 border-top">
                                        <div class="fw-semibold small text-muted text-uppercase mb-2" style="font-size: 0.72rem;">Експертні відгуки:</div>
                                        @foreach (var fb in interview.Feedbacks)
                                        {
                                            <div class="p-2 rounded surface-elevated border mb-1 small">
                                                <div class="d-flex justify-content-between align-items-center mb-1">
                                                    <span class="fw-bold font-monospace text-emerald">Оцінка: @fb.Score / 10</span>
                                                    <span class="@HrOptions.FeedbackRecommendationBadge(fb.Recommendation)">@HrOptions.FeedbackRecommendationLabel(fb.Recommendation)</span>
                                                </div>
                                                <div class="text-muted">@fb.Comment</div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="col-12 mt-2">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h2 class="h5 mb-0">Історія звернень та комунікацій</h2>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge-soft badge-soft-blue font-monospace">@Model.Communications.Count листів</span>
                    <button type="button" class="btn btn-sm btn-outline-primary" data-outreach-btn data-candidate-id="@Model.Id" data-candidate-name="@Model.FullName" data-candidate-email="@Model.Email" data-vacancy="@(Model.Applications.FirstOrDefault()?.Vacancy?.Title ?? "")">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
                        Написати листа
                    </button>
                </div>
            </div>
            <div class="card-body p-4">
                @if (Model.Communications.Any())
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var comm in Model.Communications.OrderByDescending(c => c.SentAt))
                        {
                            <div class="p-3 rounded-3 surface-subtle border">
                                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge-soft badge-soft-slate">@comm.Channel</span>
                                        <strong>@comm.Subject</strong>
                                    </div>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="text-muted small">Відправник: @comm.SenderName</span>
                                        <span class="text-muted small font-monospace">@comm.SentAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                                    </div>
                                </div>
                                <div class="small text-muted" style="white-space: pre-wrap;">@comm.Body</div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state">Листів та повідомлень кандидату ще не надсилалось.</div>
                }
            </div>
        </div>
    </div>
</div>

@await Html.PartialAsync("_OutreachModal")
