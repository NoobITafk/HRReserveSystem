@model RecruiterFormViewModel

@{
    ViewData["Title"] = "Новий користувач системи";
}

<div class="form-card-container">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <span class="section-eyebrow">Адміністрування команди</span>
            <h1 class="h2 fw-bold mb-1">Новий користувач</h1>
            <p class="text-muted mb-0">Створення облікового запису співробітника та призначення системної ролі.</p>
        </div>
        <a class="btn btn-outline-secondary" asp-action="Index">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
            Назад до списку
        </a>
    </div>

    <div class="form-card">
        <form asp-action="Create" class="row g-3">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small col-12 mb-2"></div>

            <div class="col-md-6">
                <label asp-for="FullName" class="form-label fw-semibold">Повне ім'я (ПІБ)</label>
                <input asp-for="FullName" class="form-control" placeholder="Наприклад: Наталія Бондар" />
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Email" class="form-label fw-semibold">Корпоративний Email</label>
                <input asp-for="Email" class="form-control" type="email" placeholder="n.bondar@company.ua" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Login" class="form-label fw-semibold">Логін для входу</label>
                <input asp-for="Login" class="form-control font-monospace" placeholder="nbondar" autocomplete="username" />
                <span asp-validation-for="Login" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Password" class="form-label fw-semibold">Пароль доступу</label>
                <input asp-for="Password" class="form-control" type="password" autocomplete="new-password" placeholder="••••••••" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Role" class="form-label fw-semibold">Роль у системі</label>
                <select asp-for="Role" class="form-select">
                    @foreach (var role in HrOptions.RecruiterRoles)
                    {
                        <option value="@role">@role</option>
                    }
                </select>
                <span asp-validation-for="Role" class="text-danger small"></span>
            </div>

            <div class="col-12 pt-3 border-top d-flex flex-wrap gap-2 justify-content-between align-items-center">
                <a class="btn btn-outline-secondary" asp-action="Index">Скасувати</a>
                <button type="submit" class="btn btn-primary">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg>
                    Створити користувача
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
