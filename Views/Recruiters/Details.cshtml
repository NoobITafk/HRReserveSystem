@model Recruiter

@{
    ViewData["Title"] = "Профіль співробітника";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <span class="section-eyebrow">Співробітник #@Model.Id</span>
        <h1 class="h2 fw-bold mb-1 d-flex align-items-center gap-2">
            <span>@Model.FullName</span>
            <span class="@HrOptions.RecruiterRoleBadge(Model.Role)">@HrOptions.RecruiterRoleLabel(Model.Role)</span>
        </h1>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.Id">Редагувати</a>
        <a class="btn btn-outline-secondary" asp-action="Index"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>До списку</a>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header">
        <h2 class="h5 mb-0">Облікові дані</h2>
    </div>
    <div class="card-body">
        <dl class="detail-list">
            <div class="detail-row">
                <dt>Електронна пошта</dt>
                <dd>@Model.Email</dd>
            </div>
            <div class="detail-row">
                <dt>Логін</dt>
                <dd><code class="font-monospace">@Model.Login</code></dd>
            </div>
            <div class="detail-row">
                <dt>Роль у системі</dt>
                <dd><span class="@HrOptions.RecruiterRoleBadge(Model.Role)">@HrOptions.RecruiterRoleLabel(Model.Role)</span></dd>
            </div>
            <div class="detail-row">
                <dt>Дата реєстрації</dt>
                <dd class="font-monospace">@Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</dd>
            </div>
        </dl>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted small text-uppercase">Призначені співбесіди</div>
                <div class="display-6 fw-bold font-monospace">@Model.Interviews.Count</div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted small text-uppercase">Надані експертні відгуки</div>
                <div class="display-6 fw-bold font-monospace">@Model.Feedbacks.Count</div>
            </div>
        </div>
    </div>
</div>
