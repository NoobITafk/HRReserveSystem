@model Interview

@{
    ViewData["Title"] = "Деталі співбесіди";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <span class="section-eyebrow">Зустріч #@Model.Id · @HrOptions.InterviewTypeLabel(Model.InterviewType)</span>
        <h1 class="h2 fw-bold mb-1 d-flex align-items-center gap-2">
            <span>Співбесіда: @Model.Application?.Candidate?.FullName</span>
            <span class="@HrOptions.InterviewResultBadge(Model.Result)">@HrOptions.InterviewResultLabel(Model.Result)</span>
        </h1>
        <div class="text-muted small">Вакансія: @Model.Application?.Vacancy?.Title</div>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-primary" asp-controller="InterviewFeedbacks" asp-action="Create" asp-route-interviewId="@Model.Id"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14"/><path d="M5 12h14"/></svg> Додати відгук</a>
        <a class="btn btn-outline-primary" asp-action="GoogleCalendar" asp-route-id="@Model.Id" target="_blank" rel="noopener">Google Calendar</a>
        <a class="btn btn-outline-secondary" asp-action="ExportIcs" asp-route-id="@Model.Id">Експорт .ics</a>
        @if (User.IsInRole("Admin") || User.IsInRole("Recruiter"))
        {
            <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.Id">Редагувати</a>
        }
        <a class="btn btn-outline-secondary" asp-action="Index"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>До списку</a>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header">
        <h2 class="h5 mb-0">Параметри зустрічі</h2>
    </div>
    <div class="card-body">
        <dl class="detail-list">
            <div class="detail-row">
                <dt>Кандидат</dt>
                <dd>@Model.Application?.Candidate?.FullName</dd>
            </div>
            <div class="detail-row">
                <dt>Вакансія</dt>
                <dd>@Model.Application?.Vacancy?.Title</dd>
            </div>
            <div class="detail-row">
                <dt>Відповідальний рекрутер / інтерв'юер</dt>
                <dd>@(Model.Recruiter?.FullName ?? "Не призначено")</dd>
            </div>
            <div class="detail-row">
                <dt>Дата та час</dt>
                <dd class="font-monospace">@Model.InterviewDate.ToString("dd.MM.yyyy HH:mm")</dd>
            </div>
            <div class="detail-row">
                <dt>Етап інтерв'ю</dt>
                <dd><span class="badge-soft badge-soft-slate">@HrOptions.InterviewTypeLabel(Model.InterviewType)</span></dd>
            </div>
            <div class="detail-row">
                <dt>Статус / Результат</dt>
                <dd><span class="@HrOptions.InterviewResultBadge(Model.Result)">@HrOptions.InterviewResultLabel(Model.Result)</span></dd>
            </div>
            <div class="detail-row">
                <dt>Нотатки до зустрічі</dt>
                <dd>@(string.IsNullOrWhiteSpace(Model.Notes) ? "Нотатки відсутні" : Model.Notes)</dd>
            </div>
        </dl>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h2 class="h5 mb-0">Відгуки інтерв'юерів</h2>
        <span class="badge-soft badge-soft-slate font-monospace">@Model.Feedbacks.Count</span>
    </div>
    @if (Model.Feedbacks.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Інтерв'юер</th>
                        <th>Оцінка</th>
                        <th>Рекомендація</th>
                        <th>Коментар</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var feedback in Model.Feedbacks)
                {
                    <tr>
                        <td class="fw-semibold">@(feedback.Recruiter?.FullName ?? "Не вказано")</td>
                        <td><span class="badge-soft badge-soft-blue font-monospace">@feedback.Score / 10</span></td>
                        <td><span class="@HrOptions.FeedbackRecommendationBadge(feedback.Recommendation)">@HrOptions.FeedbackRecommendationLabel(feedback.Recommendation)</span></td>
                        <td>@feedback.Comment</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">Відгуків для цієї співбесіди ще не додано.</div>
    }
</div>
