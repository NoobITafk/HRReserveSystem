@model IEnumerable<Interview>

@{
    ViewData["Title"] = "Співбесіди";
    var currentPage = ViewBag.CurrentPage as int? ?? 1;
    var totalPages = ViewBag.TotalPages as int? ?? 1;
    var totalItems = ViewBag.TotalItems as int? ?? 0;
    var currentType = ViewData["InterviewTypeFilter"] as string;
    var currentResult = ViewData["ResultFilter"] as string;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <span class="section-eyebrow">Розклад зустрічей</span>
        <h1 class="h2 fw-bold mb-1">Співбесіди <span class="badge-soft badge-soft-slate font-monospace ms-1">@Model.Count()</span></h1>
        <p class="text-muted mb-0">Історія та розклад HR, технічних і фінальних співбесід із відповідальними рекрутерами.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-outline-primary" asp-action="Calendar">Календар зустрічей</a>
        <a class="btn btn-outline-secondary" asp-action="ExportIcs">Експорт .ics</a>
        @if (User.IsInRole("Admin") || User.IsInRole("Recruiter"))
        {
            <a class="btn btn-primary" asp-action="Create"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14"/><path d="M5 12h14"/></svg> Запланувати співбесіду</a>
        }
    </div>
</div>

<form asp-action="Index" method="get" class="card mb-4">
    <div class="card-body row g-3 align-items-end">
        <div class="col-sm-6 col-lg-4">
            <label class="form-label fw-medium" for="interviewType">Тип співбесіди</label>
            <select id="interviewType" class="form-select" name="interviewType" asp-items="ViewBag.InterviewTypes">
                <option value="">Усі типи</option>
            </select>
        </div>
        <div class="col-sm-6 col-lg-4">
            <label class="form-label fw-medium" for="result">Результат</label>
            <select id="result" class="form-select" name="result" asp-items="ViewBag.Results">
                <option value="">Усі результати</option>
            </select>
        </div>
        <div class="col-sm-12 col-lg-4 d-flex gap-2">
            <button class="btn btn-primary flex-fill" type="submit">Фільтрувати</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Скинути</a>
        </div>
    </div>
</form>

<div class="card">
    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Кандидат</th>
                        <th>Вакансія</th>
                        <th>Відповідальний</th>
                        <th>Дата та час</th>
                        <th>Етап</th>
                        <th>Результат</th>
                        <th class="text-end">Дії</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr class="clickable-row" data-row-link="@Url.Action("Details", new { id = item.Id })" tabindex="0">
                        <td class="fw-semibold">@item.Application?.Candidate?.FullName</td>
                        <td>@item.Application?.Vacancy?.Title</td>
                        <td>@(item.Recruiter?.FullName ?? "Не призначено")</td>
                        <td class="font-monospace small">@item.InterviewDate.ToString("dd.MM.yyyy HH:mm")</td>
                        <td><span class="badge-soft badge-soft-slate">@HrOptions.InterviewTypeLabel(item.InterviewType)</span></td>
                        <td><span class="@HrOptions.InterviewResultBadge(item.Result)">@HrOptions.InterviewResultLabel(item.Result)</span></td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@item.Id">Деталі</a>
                            @if (User.IsInRole("Admin") || User.IsInRole("Recruiter"))
                            {
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@item.Id">Редагувати</a>
                                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id">Видалити</a>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        if (totalPages > 1)
        {
            <div class="card-footer bg-surface border-top d-flex justify-content-between align-items-center py-2 px-3">
                <span class="small text-muted">Показано @Model.Count() із @totalItems співбесід (сторінка @currentPage з @totalPages)</span>
                <div class="d-flex gap-1">
                    @if (currentPage > 1)
                    {
                        <a asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-interviewType="@currentType" asp-route-result="@currentResult" class="btn btn-sm btn-outline-secondary">Назад</a>
                    }
                    @if (currentPage < totalPages)
                    {
                        <a asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-interviewType="@currentType" asp-route-result="@currentResult" class="btn btn-sm btn-outline-secondary">Вперед</a>
                    }
                </div>
            </div>
        }
    }
    else
    {
        <div class="empty-state">
            <h2 class="h5 fw-bold">Запланованих співбесід немає</h2>
            <p class="text-muted mb-3">Оберіть інші фільтри або заплануйте нову зустріч із кандидатом.</p>
            @if (User.IsInRole("Admin") || User.IsInRole("Recruiter"))
            {
                <a class="btn btn-primary" asp-action="Create"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14"/><path d="M5 12h14"/></svg> Запланувати співбесіду</a>
            }
        </div>
    }
</div>
