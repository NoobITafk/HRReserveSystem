@model IEnumerable<Interview>

@{
    ViewData["Title"] = "Календар співбесід";
    var days = Model
        .OrderBy(interview => interview.InterviewDate)
        .GroupBy(interview => interview.InterviewDate.Date)
        .ToList();
    var today = DateTime.Today;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <span class="section-eyebrow">Таймлайн зустрічей</span>
        <h1 class="h2 fw-bold mb-1">Календар співбесід</h1>
        <p class="text-muted mb-0">Розклад зустрічей за датами з прямим експортом у Google Calendar та .ics.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-outline-secondary" asp-action="Index">Табличний список</a>
        <a class="btn btn-outline-primary" asp-action="ExportIcs">Експорт .ics</a>
        @if (User.IsInRole("Admin") || User.IsInRole("Recruiter"))
        {
            <a class="btn btn-primary" asp-action="Create"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14"/><path d="M5 12h14"/></svg> Запланувати зустріч</a>
        }
    </div>
</div>

@if (days.Any())
{
    <div class="interview-calendar">
        @foreach (var day in days)
        {
            var dayClass = day.Key == today ? "calendar-day calendar-day-today" : "calendar-day";

            <section class="@dayClass">
                <div class="calendar-day-head">
                    <div>
                        <span class="calendar-weekday">@day.Key.ToString("dddd")</span>
                        <h2 class="h5 mb-0 font-monospace">@day.Key.ToString("dd.MM.yyyy")</h2>
                    </div>
                    <span class="badge-soft badge-soft-blue font-monospace">@day.Count()</span>
                </div>

                <div class="calendar-events">
                    @foreach (var interview in day)
                    {
                        <article class="calendar-event">
                            <div class="calendar-event-time font-monospace">@interview.InterviewDate.ToString("HH:mm")</div>
                            <div class="calendar-event-body">
                                <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                                    <strong>@interview.Application?.Candidate?.FullName</strong>
                                    <span class="@HrOptions.InterviewResultBadge(interview.Result)">@HrOptions.InterviewResultLabel(interview.Result)</span>
                                </div>
                                <div class="text-muted">@interview.Application?.Vacancy?.Title</div>
                                <div class="small text-muted">@HrOptions.InterviewTypeLabel(interview.InterviewType) · @(interview.Recruiter?.FullName ?? "Не призначено")</div>
                            </div>
                            <div class="d-flex flex-wrap gap-2">
                                <a class="btn btn-sm btn-outline-secondary" asp-action="GoogleCalendar" asp-route-id="@interview.Id" target="_blank" rel="noopener">Google</a>
                                <a class="btn btn-sm btn-outline-secondary" asp-action="ExportIcs" asp-route-id="@interview.Id">.ics</a>
                                <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@interview.Id">Деталі</a>
                            </div>
                        </article>
                    }
                </div>
            </section>
        }
    </div>
}
else
{
    <div class="empty-state">
        <h2 class="h5 fw-bold">Співбесіди ще не заплановані</h2>
        <p class="text-muted mb-3">Календар заповнюється автоматично після призначення співбесід кандидатам.</p>
        @if (User.IsInRole("Admin") || User.IsInRole("Recruiter"))
        {
            <a class="btn btn-primary" asp-action="Create"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14"/><path d="M5 12h14"/></svg> Запланувати співбесіду</a>
        }
    </div>
}
