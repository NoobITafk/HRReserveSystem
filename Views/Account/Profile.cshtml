@model HRReserveSystem.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = Model.IsCandidate ? "Мій кабінет кандидата та портфоліо" : "Налаштування профілю";
    var initial = string.IsNullOrWhiteSpace(Model.FullName) ? "U" : Model.FullName.Trim()[0].ToString().ToUpperInvariant();
    var hasSoftSkills = Model.CandidateSoftSkills is not null;
}

<div class="profile-hero mb-4">
    <div class="profile-hero-card">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-4">
            <div class="d-flex align-items-center gap-3 gap-md-4">
                <div class="profile-avatar-wrapper position-relative">
                    @if (!string.IsNullOrWhiteSpace(Model.AvatarUrl))
                    {
                        <img src="@Model.AvatarUrl" alt="@Model.FullName" class="profile-avatar profile-avatar-xl profile-avatar-img shadow-sm" id="avatarPreview" />
                    }
                    else
                    {
                        <div class="profile-avatar profile-avatar-xl shadow-sm" id="avatarPreviewFallback">@initial</div>
                        <img src="" alt="" class="profile-avatar profile-avatar-xl profile-avatar-img shadow-sm d-none" id="avatarPreview" />
                    }
                    <label for="avatarFileInput" class="avatar-edit-badge" title="Змінити фото">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
                    </label>
                </div>

                <div>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <h1 class="h2 fw-bold mb-0">@Model.FullName</h1>
                        <span class="@HrOptions.RecruiterRoleBadge(Model.Role)">@HrOptions.RecruiterRoleLabel(Model.Role)</span>
                    </div>
                    <div class="d-flex flex-wrap align-items-center gap-3 text-muted small">
                        <span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>@Model.Email</span>
                        <span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>У системі з @Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</span>
                        @if (!string.IsNullOrWhiteSpace(Model.Phone))
                        {
                            <span class="font-monospace"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>@Model.Phone</span>
                        }
                    </div>
                </div>
            </div>

            <div class="d-flex align-items-center gap-2">
                @if (Model.IsCandidate && !string.IsNullOrWhiteSpace(Model.ResumeFilePath))
                {
                    <a class="btn btn-outline-primary" href="@Model.ResumeFilePath" target="_blank" download>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                        Завантажити резюме (CV)
                    </a>
                }
                <a class="btn btn-outline-secondary" asp-controller="Home" asp-action="Index">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
                    На головну
                </a>
            </div>
        </div>

        <!-- Dynamic Navigation Tabs -->
        <ul class="nav nav-tabs profile-nav-tabs mt-4" id="profileTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="portfolio-tab" data-bs-toggle="tab" data-bs-target="#portfolio" type="button" role="tab" aria-controls="portfolio" aria-selected="true">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><rect width="20" height="14" x="2" y="7" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
                    @(Model.IsCandidate ? "Портфоліо та резюме" : "Особисті дані")
                </button>
            </li>
            @if (Model.IsCandidate)
            {
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="skills-tab" data-bs-toggle="tab" data-bs-target="#skills" type="button" role="tab" aria-controls="skills" aria-selected="false">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                        Оцінки Soft Skills
                        @if (hasSoftSkills)
                        {
                            <span class="badge bg-success ms-1">@Model.CandidateSoftSkills!.AverageScore.ToString("F1")</span>
                        }
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="interviews-tab" data-bs-toggle="tab" data-bs-target="#interviews" type="button" role="tab" aria-controls="interviews" aria-selected="false">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/><path d="M8 10h.01"/><path d="M12 10h.01"/><path d="M16 10h.01"/></svg>
                        Співбесіди та відгуки
                        <span class="badge bg-secondary ms-1">@Model.CandidateInterviews.Count</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="applications-tab" data-bs-toggle="tab" data-bs-target="#applications" type="button" role="tab" aria-controls="applications" aria-selected="false">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><path d="M6 3v12"/><circle cx="18" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M18 9a9 9 0 0 1-9 9"/></svg>
                        Заявки на вакансії
                        <span class="badge bg-secondary ms-1">@Model.CandidateApplications.Count</span>
                    </button>
                </li>
            }
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="security-tab" data-bs-toggle="tab" data-bs-target="#security" type="button" role="tab" aria-controls="security" aria-selected="false">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                    Безпека та пароль
                </button>
            </li>
        </ul>
    </div>
</div>

<form asp-action="Profile" method="post" enctype="multipart/form-data" id="profileForm">
    <input type="hidden" asp-for="Id" />
    <input type="file" asp-for="AvatarFile" id="avatarFileInput" class="d-none" accept=".jpg,.jpeg,.png,.webp" />

    <div class="tab-content" id="profileTabsContent">
        <!-- TAB 1: PORTFOLIO & CV -->
        <div class="tab-pane fade show active" id="portfolio" role="tabpanel" aria-labelledby="portfolio-tab">
            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="card mb-4">
                        <div class="card-header d-flex align-items-center justify-content-between">
                            <h2 class="h5 mb-0 fw-bold">Головне резюме (CV) та портфоліо</h2>
                            <span class="badge-soft badge-soft-emerald">Підтримка PDF / DOCX</span>
                        </div>
                        <div class="card-body p-4">
                            <div class="resume-upload-zone p-4 mb-4 text-center rounded-3 border border-dashed surface-subtle">
                                <div class="upload-icon mb-2 text-emerald">
                                    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><line x1="9" y1="15" x2="15" y2="15"/></svg>
                                </div>
                                <h6 class="fw-bold mb-1">Завантажте ваше свіже резюме</h6>
                                <p class="text-muted small mb-3">Система автоматично витягне та структурує найголовніше: технологічний стек, досвід та короткий опис.</p>
                                
                                <div class="d-inline-flex flex-wrap gap-2 justify-content-center align-items-center">
                                    <input type="file" asp-for="ResumeFile" class="form-control form-control-sm w-auto" accept=".pdf,.doc,.docx" />
                                    <button type="submit" class="btn btn-sm btn-primary">
                                        Зберегти та проаналізувати
                                    </button>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(Model.ResumeFilePath))
                                {
                                    <div class="mt-3 small text-muted">
                                        Поточний файл: <a href="@Model.ResumeFilePath" target="_blank" class="fw-semibold text-emerald">@System.IO.Path.GetFileName(Model.ResumeFilePath)</a>
                                    </div>
                                }
                            </div>

                            <!-- PDF INTEL & SUMMARY EXTRACTED SECTION -->
                            @if (Model.ParsedResume is not null && Model.ParsedResume.Success)
                            {
                                <div class="parsed-resume-card p-4 rounded-3 surface-elevated border border-emerald-subtle mb-4">
                                    <div class="d-flex align-items-center gap-2 mb-3">
                                        <span class="badge-soft badge-soft-emerald">Розпізнано з PDF резюме</span>
                                        <span class="text-muted small">Автоматичний аналіз системи</span>
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(Model.ParsedResume.Summary))
                                    {
                                        <div class="mb-3">
                                            <h6 class="fw-bold mb-1 text-emerald">Головне резюме / Експертний огляд:</h6>
                                            <p class="text-muted small mb-0 leading-relaxed">@Model.ParsedResume.Summary</p>
                                        </div>
                                    }

                                    @if (Model.ParsedResume.DetectedSkills.Count > 0)
                                    {
                                        <div class="mb-3">
                                            <div class="fw-semibold small mb-2 text-uppercase tracking-wider text-muted">Виявлений стек технологій:</div>
                                            <div class="d-flex flex-wrap gap-1">
                                                @foreach (var skill in Model.ParsedResume.DetectedSkills)
                                                {
                                                    <span class="badge-soft badge-soft-blue">@skill</span>
                                                }
                                            </div>
                                        </div>
                                    }

                                    @if (Model.ParsedResume.KeyHighlights.Count > 0)
                                    {
                                        <div>
                                            <div class="fw-semibold small mb-1 text-uppercase tracking-wider text-muted">Ключові сильні сторони та компетенції:</div>
                                            <ul class="small text-muted mb-0 ps-3">
                                                @foreach (var hl in Model.ParsedResume.KeyHighlights)
                                                {
                                                    <li>@hl</li>
                                                }
                                            </ul>
                                        </div>
                                    }
                                </div>
                            }

                            <!-- EDITABLE PORTFOLIO FIELDS -->
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="FullName" class="form-label fw-semibold">ПІБ</label>
                                    <input asp-for="FullName" class="form-control" />
                                    <span asp-validation-for="FullName" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="Email" class="form-label fw-semibold">Електронна пошта</label>
                                    <input asp-for="Email" class="form-control" type="email" />
                                    <span asp-validation-for="Email" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="Phone" class="form-label fw-semibold">Контактний телефон</label>
                                    <input asp-for="Phone" class="form-control font-monospace" placeholder="+380XXXXXXXXX" />
                                    <span asp-validation-for="Phone" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="ExperienceYears" class="form-label fw-semibold">Загальний досвід, років</label>
                                    <input asp-for="ExperienceYears" class="form-control font-monospace" type="number" min="0" max="50" />
                                    <span asp-validation-for="ExperienceYears" class="text-danger small"></span>
                                </div>

                                <div class="col-12">
                                    <label asp-for="Skills" class="form-label fw-semibold">Ключові навички та технології</label>
                                    <textarea asp-for="Skills" class="form-control" rows="2" placeholder="Наприклад: C#, .NET 8, PostgreSQL, Docker, React, Git"></textarea>
                                    <div class="form-text">Вкажіть через кому ваші основні інструменти та мови програмування.</div>
                                    <span asp-validation-for="Skills" class="text-danger small"></span>
                                </div>

                                <div class="col-12">
                                    <label asp-for="ResumeSummary" class="form-label fw-semibold">Короткий опис про себе / Супровідний текст</label>
                                    <textarea asp-for="ResumeSummary" class="form-control" rows="3" placeholder="Розкажіть про свої сильні сторони, реалізовані проєкти або кар'єрні цілі..."></textarea>
                                    <span asp-validation-for="ResumeSummary" class="text-danger small"></span>
                                </div>

                                <div class="col-12 pt-2 d-flex justify-content-end">
                                    <button type="submit" class="btn btn-primary px-4">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                                        Зберегти дані портфоліо
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- RIGHT SIDEBAR: QUICK STATS -->
                <div class="col-lg-4">
                    <div class="card mb-4">
                        <div class="card-header">
                            <h3 class="h6 mb-0 fw-bold">Картка облікового запису</h3>
                        </div>
                        <div class="card-body p-4">
                            <dl class="detail-list mb-0">
                                <div class="detail-row">
                                    <dt>Логін</dt>
                                    <dd class="font-monospace">@Model.Login</dd>
                                </div>
                                <div class="detail-row">
                                    <dt>Системна роль</dt>
                                    <dd><span class="@HrOptions.RecruiterRoleBadge(Model.Role)">@HrOptions.RecruiterRoleLabel(Model.Role)</span></dd>
                                </div>
                                <div class="detail-row">
                                    <dt>Резюме (CV)</dt>
                                    <dd>@(string.IsNullOrWhiteSpace(Model.ResumeFilePath) ? "Не завантажено" : "Додано ✓")</dd>
                                </div>
                                <div class="detail-row">
                                    <dt>Оцінка Soft Skills</dt>
                                    <dd class="fw-bold @(hasSoftSkills ? "text-emerald" : "text-muted")">
                                        @(hasSoftSkills ? $"{Model.CandidateSoftSkills!.AverageScore:F1} / 10" : "Очікує оцінки")
                                    </dd>
                                </div>
                            </dl>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-header">
                            <h3 class="h6 mb-0 fw-bold">Зміна фотографії профілю</h3>
                        </div>
                        <div class="card-body p-4 text-center">
                            <p class="text-muted small mb-3">Ви можете обрати файл із вашого комп'ютера у форматі JPG, PNG або WEBP.</p>
                            <label for="avatarFileInput" class="btn btn-outline-secondary btn-sm w-100">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                                Обрати нове фото
                            </label>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (Model.IsCandidate)
        {
            <!-- TAB 2: SOFT SKILLS EVALUATION -->
            <div class="tab-pane fade" id="skills" role="tabpanel" aria-labelledby="skills-tab">
                <div class="card">
                    <div class="card-header d-flex flex-wrap align-items-center justify-content-between gap-2">
                        <div>
                            <h2 class="h5 mb-1 fw-bold">Матриця Soft Skills та оцінювання кандидата</h2>
                            <p class="text-muted small mb-0">Оцінки особистісних якостей, виставлені технічними інтерв'юерами та HR-експертами.</p>
                        </div>
                        @if (hasSoftSkills)
                        {
                            <div class="d-flex align-items-center gap-2">
                                <span class="text-muted small">Підсумковий рейтинг:</span>
                                <span class="h4 mb-0 fw-bold font-monospace text-emerald">@Model.CandidateSoftSkills!.AverageScore.ToString("F1")</span>
                                <span class="text-muted small">/ 10</span>
                            </div>
                        }
                    </div>

                    <div class="card-body p-4">
                        @if (!hasSoftSkills)
                        {
                            <div class="text-center py-5">
                                <div class="auth-feature-icon icon-amber mx-auto mb-3" style="width: 52px; height: 52px;">
                                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                                </div>
                                <h5 class="fw-bold mb-1">Оцінку Soft Skills ще не виставлено</h5>
                                <p class="text-muted small max-w-sm mx-auto mb-0">
                                    Після проходження технічної або HR-співбесіди інтерв'юер проведе комплексне оцінювання ваших компетенцій за 5 критеріями.
                                </p>
                            </div>
                        }
                        else
                        {
                            var s = Model.CandidateSoftSkills!;
                            <div class="row g-4 mb-4">
                                <div class="col-md-6 col-lg-4">
                                    <div class="p-3 rounded-3 surface-subtle border">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <span class="fw-semibold small">Комунікація</span>
                                            <span class="badge-soft badge-soft-emerald font-monospace">@s.Communication / 10</span>
                                        </div>
                                        <div class="progress" style="height: 8px;">
                                            <div class="progress-bar bg-success" role="progressbar" style="width: @(s.Communication * 10)%" aria-valuenow="@s.Communication" aria-valuemin="0" aria-valuemax="10"></div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6 col-lg-4">
                                    <div class="p-3 rounded-3 surface-subtle border">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <span class="fw-semibold small">Робота в команді</span>
                                            <span class="badge-soft badge-soft-blue font-monospace">@s.Teamwork / 10</span>
                                        </div>
                                        <div class="progress" style="height: 8px;">
                                            <div class="progress-bar bg-primary" role="progressbar" style="width: @(s.Teamwork * 10)%" aria-valuenow="@s.Teamwork" aria-valuemin="0" aria-valuemax="10"></div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6 col-lg-4">
                                    <div class="p-3 rounded-3 surface-subtle border">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <span class="fw-semibold small">Відповідальність</span>
                                            <span class="badge-soft badge-soft-violet font-monospace">@s.Responsibility / 10</span>
                                        </div>
                                        <div class="progress" style="height: 8px;">
                                            <div class="progress-bar bg-info" role="progressbar" style="width: @(s.Responsibility * 10)%" aria-valuenow="@s.Responsibility" aria-valuemin="0" aria-valuemax="10"></div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6 col-lg-6">
                                    <div class="p-3 rounded-3 surface-subtle border">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <span class="fw-semibold small">Стресостійкість</span>
                                            <span class="badge-soft badge-soft-cyan font-monospace">@s.StressResistance / 10</span>
                                        </div>
                                        <div class="progress" style="height: 8px;">
                                            <div class="progress-bar bg-warning" role="progressbar" style="width: @(s.StressResistance * 10)%" aria-valuenow="@s.StressResistance" aria-valuemin="0" aria-valuemax="10"></div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-12 col-lg-6">
                                    <div class="p-3 rounded-3 surface-subtle border">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <span class="fw-semibold small">Лідерські якості</span>
                                            <span class="badge-soft badge-soft-amber font-monospace">@s.Leadership / 10</span>
                                        </div>
                                        <div class="progress" style="height: 8px;">
                                            <div class="progress-bar bg-warning" role="progressbar" style="width: @(s.Leadership * 10)%" aria-valuenow="@s.Leadership" aria-valuemin="0" aria-valuemax="10"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(s.OverallComment))
                            {
                                <div class="p-4 rounded-3 surface-subtle border">
                                    <h6 class="fw-bold mb-2">Розгорнутий коментар експерта:</h6>
                                    <p class="text-muted mb-0 leading-relaxed">@s.OverallComment</p>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>

            <!-- TAB 3: INTERVIEWS & FEEDBACKS -->
            <div class="tab-pane fade" id="interviews" role="tabpanel" aria-labelledby="interviews-tab">
                <div class="card">
                    <div class="card-header">
                        <h2 class="h5 mb-0 fw-bold">Історія співбесід та експертні відгуки</h2>
                    </div>
                    <div class="card-body p-4">
                        @if (Model.CandidateInterviews.Count == 0)
                        {
                            <div class="text-center py-5">
                                <div class="auth-feature-icon icon-blue mx-auto mb-3" style="width: 52px; height: 52px;">
                                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                                </div>
                                <h5 class="fw-bold mb-1">Співбесід ще не призначено</h5>
                                <p class="text-muted small mb-0">Коли рекрутер призначить інтерв'ю на обрану вакансію, воно з'явиться тут із датою та посиланням на зустріч.</p>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex flex-column gap-3">
                                @foreach (var interview in Model.CandidateInterviews)
                                {
                                    <div class="p-4 rounded-3 surface-subtle border">
                                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                                            <div>
                                                <span class="badge-soft badge-soft-blue me-2">@HrOptions.InterviewTypeLabel(interview.InterviewType)</span>
                                                <strong class="fs-6">@(interview.Application?.Vacancy?.Title ?? "Загальна вакансія")</strong>
                                            </div>
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="text-muted small font-monospace">@interview.InterviewDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                                                <span class="@HrOptions.InterviewResultBadge(interview.Result)">@HrOptions.InterviewResultLabel(interview.Result)</span>
                                            </div>
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(interview.Notes))
                                        {
                                            <div class="small text-muted mb-2">
                                                <span>Місце / Посилання: </span>
                                                @if (interview.Notes.StartsWith("http", StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <a href="@interview.Notes" target="_blank" class="fw-semibold text-emerald">Приєднатися до дзвінка →</a>
                                                }
                                                else
                                                {
                                                    <span class="fw-semibold">@interview.Notes</span>
                                                }
                                            </div>
                                        }

                                        <!-- Feedbacks inside this interview -->
                                        @if (interview.Feedbacks.Count > 0)
                                        {
                                            <div class="mt-3 pt-3 border-top">
                                                <h6 class="small fw-bold text-uppercase tracking-wider text-muted mb-2">Оцінки інтерв'юерів за цією співбесідою:</h6>
                                                @foreach (var fb in interview.Feedbacks)
                                                {
                                                    <div class="p-3 rounded-2 surface-elevated border mb-2">
                                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                                            <div class="d-flex align-items-center gap-2">
                                                                <span class="fw-bold font-monospace text-emerald">Бал: @fb.Score / 10</span>
                                                                <span class="@HrOptions.FeedbackRecommendationBadge(fb.Recommendation)">@HrOptions.FeedbackRecommendationLabel(fb.Recommendation)</span>
                                                            </div>
                                                            <span class="text-muted small font-monospace">@fb.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</span>
                                                        </div>
                                                        <p class="text-muted small mb-0">@fb.Comment</p>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- TAB 4: JOB APPLICATIONS -->
            <div class="tab-pane fade" id="applications" role="tabpanel" aria-labelledby="applications-tab">
                <div class="card">
                    <div class="card-header">
                        <h2 class="h5 mb-0 fw-bold">Мої подані заявки на вакансії</h2>
                    </div>
                    <div class="card-body p-4">
                        @if (Model.CandidateApplications.Count == 0)
                        {
                            <div class="text-center py-5">
                                <div class="auth-feature-icon icon-emerald mx-auto mb-3" style="width: 52px; height: 52px;">
                                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="14" x="2" y="7" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
                                </div>
                                <h5 class="fw-bold mb-1">Заявок ще немає</h5>
                                <p class="text-muted small mb-3">Ознайомтесь із відкритими позиціями компанії та подайте резюме.</p>
                                <a class="btn btn-outline-primary btn-sm" asp-controller="Vacancies" asp-action="Index">
                                    Переглянути відкриті вакансії →
                                </a>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th>Вакансія</th>
                                            <th>Дата подачі</th>
                                            <th>Поточний статус відбору</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var app in Model.CandidateApplications)
                                        {
                                            <tr>
                                                <td class="fw-semibold">@(app.Vacancy?.Title ?? "Позиція")</td>
                                                <td class="font-monospace small text-muted">@app.AppliedAt.ToLocalTime().ToString("dd.MM.yyyy")</td>
                                                <td>
                                                    <span class="@HrOptions.ApplicationStatusBadge(app.Status)">@HrOptions.ApplicationStatusLabel(app.Status)</span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- TAB 5: SECURITY & PASSWORD -->
        <div class="tab-pane fade" id="security" role="tabpanel" aria-labelledby="security-tab">
            <div class="card">
                <div class="card-header">
                    <h2 class="h5 mb-0 fw-bold">Безпека облікового запису та зміна пароля</h2>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="CurrentPassword" class="form-label fw-medium">Поточний пароль</label>
                            <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" placeholder="••••••••" />
                            <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="NewPassword" class="form-label fw-medium">Новий пароль</label>
                            <input asp-for="NewPassword" class="form-control" autocomplete="new-password" placeholder="Мінімум 6 символів" />
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="ConfirmNewPassword" class="form-label fw-medium">Підтвердження нового пароля</label>
                            <input asp-for="ConfirmNewPassword" class="form-control" autocomplete="new-password" placeholder="Повторіть пароль" />
                            <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                        </div>

                        <div class="col-12 pt-3 d-flex justify-content-end">
                            <button type="submit" class="btn btn-primary px-4">
                                Оновити пароль
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var avatarInput = document.getElementById("avatarFileInput");
            var avatarPreview = document.getElementById("avatarPreview");
            var fallback = document.getElementById("avatarPreviewFallback");

            if (avatarInput) {
                avatarInput.addEventListener("change", function () {
                    if (this.files && this.files[0]) {
                        var reader = new FileReader();
                        reader.onload = function (e) {
                            if (avatarPreview) {
                                avatarPreview.src = e.target.result;
                                avatarPreview.classList.remove("d-none");
                            }
                            if (fallback) {
                                fallback.classList.add("d-none");
                            }
                        };
                        reader.readAsDataURL(this.files[0]);
                    }
                });
            }
        });
    </script>
}
