@model HRReserveSystem.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = "Особистий кабінет співробітника";
    var initial = string.IsNullOrWhiteSpace(Model.FullName) ? "U" : Model.FullName.Trim()[0].ToString().ToUpperInvariant();
}

<div class="profile-hero mb-4">
    <div class="profile-hero-card">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-4">
            <div class="d-flex align-items-center gap-3 gap-md-4">
                <div class="profile-avatar-wrapper position-relative">
                    @if (!string.IsNullOrWhiteSpace(Model.AvatarUrl))
                    {
                        <img src="@Model.AvatarUrl" alt="@Model.FullName" class="profile-avatar profile-avatar-xl profile-avatar-img shadow-sm" id="avatarPreview" />
                        <div class="profile-avatar profile-avatar-xl shadow-sm d-none" id="avatarPreviewFallback" style="display: none !important;">@initial</div>
                    }
                    else
                    {
                        <div class="profile-avatar profile-avatar-xl shadow-sm" id="avatarPreviewFallback">@initial</div>
                        <img src="" alt="@Model.FullName" class="profile-avatar profile-avatar-xl profile-avatar-img shadow-sm d-none" id="avatarPreview" style="display: none !important;" />
                    }
                    <label for="avatarFileInput" class="avatar-edit-badge" title="Змінити фото">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
                    </label>
                </div>

                <div>
                    <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                        <h1 class="h2 fw-bold mb-0">@Model.FullName</h1>
                        <span class="@HrOptions.RecruiterRoleBadge(Model.Role)">@HrOptions.RecruiterRoleLabel(Model.Role)</span>
                    </div>
                    <div class="d-flex flex-wrap align-items-center gap-3 text-muted small">
                        <span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>@Model.Email</span>
                        <span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>Логін: <strong>@Model.Login</strong></span>
                        <span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>У команді з @Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</span>
                    </div>
                </div>
            </div>

            <div class="d-flex align-items-center gap-2">
                <a class="btn btn-outline-secondary" asp-controller="Home" asp-action="Index">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
                    На панель керування
                </a>
            </div>
        </div>

        <!-- Navigation Tabs -->
        <ul class="nav nav-tabs profile-nav-tabs mt-4" id="profileTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="general-tab" data-bs-toggle="tab" data-bs-target="#general" type="button" role="tab" aria-controls="general" aria-selected="true">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    Особисті дані та фото
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="schedule-tab" data-bs-toggle="tab" data-bs-target="#schedule" type="button" role="tab" aria-controls="schedule" aria-selected="false">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                    Мої співбесіди
                    @if (Model.MyUpcomingInterviews.Count > 0)
                    {
                        <span class="badge bg-primary ms-1">@Model.MyUpcomingInterviews.Count</span>
                    }
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="feedbacks-tab" data-bs-toggle="tab" data-bs-target="#feedbacks" type="button" role="tab" aria-controls="feedbacks" aria-selected="false">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/><path d="M8 10h.01"/><path d="M12 10h.01"/><path d="M16 10h.01"/></svg>
                    Мої відгуки та оцінки
                    @if (Model.FeedbacksCount > 0)
                    {
                        <span class="badge bg-secondary ms-1">@Model.FeedbacksCount</span>
                    }
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="security-tab" data-bs-toggle="tab" data-bs-target="#security" type="button" role="tab" aria-controls="security" aria-selected="false">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                    Безпека та пароль
                </button>
            </li>
        </ul>
    </div>
</div>

<!-- Employee Productivity Strip -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="stat-card">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="stat-card-label">Співбесіди</span>
                <span class="icon-bubble icon-bubble-primary">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                </span>
            </div>
            <div class="stat-card-value">@Model.InterviewsCount</div>
            <div class="stat-card-sub text-muted small">Проведено та заплановано</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="stat-card-label">Відгуки</span>
                <span class="icon-bubble icon-bubble-teal">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                </span>
            </div>
            <div class="stat-card-value">@Model.FeedbacksCount</div>
            <div class="stat-card-sub text-muted small">Оцінено кандидатів</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="stat-card-label">Середній бал</span>
                <span class="icon-bubble icon-bubble-indigo">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                </span>
            </div>
            <div class="stat-card-value">
                @(Model.AverageFeedbackScore > 0 ? Model.AverageFeedbackScore.ToString("F1") : "—")
            </div>
            <div class="stat-card-sub text-muted small">З 10 можливих балів</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="stat-card-label">Активні вакансії</span>
                <span class="icon-bubble icon-bubble-amber">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="14" x="2" y="7" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
                </span>
            </div>
            <div class="stat-card-value">@Model.VacanciesCount</div>
            <div class="stat-card-sub text-muted small">У системі компанії</div>
        </div>
    </div>
</div>

<!-- Tab Content -->
<div class="tab-content" id="profileTabsContent">

    <!-- TAB 1: General Info & Photo -->
    <div class="tab-pane fade show active" id="general" role="tabpanel" aria-labelledby="general-tab">
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card p-4">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="icon-bubble icon-bubble-primary">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                        </span>
                        <div>
                            <h2 class="h5 fw-bold mb-0">Редагування персональних даних</h2>
                            <p class="text-muted small mb-0">Оновіть ім'я, контактний email або завантажте нове фото аватара.</p>
                        </div>
                    </div>

                    <form asp-action="Profile" method="post" enctype="multipart/form-data" novalidate id="profileForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="Login" />
                        <input type="hidden" asp-for="Role" />
                        <input type="hidden" asp-for="AvatarUrl" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="FullName" class="form-label fw-semibold"></label>
                                <input asp-for="FullName" class="form-control" placeholder="Іван Коваленко" />
                                <span asp-validation-for="FullName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-semibold"></label>
                                <input asp-for="Email" type="email" class="form-control" placeholder="employee@company.ua" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-muted">Логін облікового запису</label>
                                <input value="@Model.Login" class="form-control bg-light" disabled readonly />
                                <div class="form-text small">Логін призначається системним адміністратором.</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-muted">Поточна роль</label>
                                <input value="@HrOptions.RecruiterRoleLabel(Model.Role)" class="form-control bg-light" disabled readonly />
                                <div class="form-text small">Рівень доступу в системі: @Model.Role</div>
                            </div>
                        </div>

                        <!-- Avatar File Input (Hidden, Triggered by Button or Badge) -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold">Фото профілю (аватар)</label>
                            <div class="p-3 border rounded-3 surface-subtle d-flex flex-wrap align-items-center justify-content-between gap-3">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="profile-avatar profile-avatar-sm" style="width:48px; height:48px; font-size:1.1rem;">
                                        @if (!string.IsNullOrWhiteSpace(Model.AvatarUrl))
                                        {
                                            <img src="@Model.AvatarUrl" alt="" class="w-100 h-100 rounded-circle" style="object-fit:cover;" id="avatarSubPreview" />
                                        }
                                        else
                                        {
                                            <span id="avatarSubFallback">@initial</span>
                                        }
                                    </div>
                                    <div>
                                        <div class="fw-semibold small">Оберіть якісне фото (JPG, PNG, WebP)</div>
                                        <div class="text-muted small">Максимальний розмір — до 5 МБ</div>
                                    </div>
                                </div>
                                <input type="file" asp-for="AvatarFile" class="d-none" id="avatarFileInput" accept=".jpg,.jpeg,.png,.webp" />
                                <button type="button" class="btn btn-sm btn-outline-primary" onclick="document.getElementById('avatarFileInput').click()">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                                    Вибрати файл...
                                </button>
                            </div>
                            <span asp-validation-for="AvatarFile" class="text-danger small"></span>
                        </div>

                        <div class="d-flex align-items-center justify-content-end gap-2 pt-2 border-top">
                            <button type="submit" class="btn btn-primary px-4">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><polyline points="20 6 9 17 4 12"/></svg>
                                Зберегти зміни
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Profile Info Sidebar -->
            <div class="col-lg-4">
                <div class="card p-4 mb-4">
                    <h3 class="h6 fw-bold mb-3 d-flex align-items-center gap-2">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-primary"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                        Інформація про обліковий запис
                    </h3>
                    <ul class="list-unstyled mb-0 d-flex flex-column gap-3 small">
                        <li class="d-flex justify-content-between pb-2 border-bottom">
                            <span class="text-muted">ID співробітника:</span>
                            <span class="font-monospace fw-semibold">#@Model.Id</span>
                        </li>
                        <li class="d-flex justify-content-between pb-2 border-bottom">
                            <span class="text-muted">Тип авторизації:</span>
                            <span class="fw-semibold">ASP.NET Identity + Cookie</span>
                        </li>
                        <li class="d-flex justify-content-between pb-2 border-bottom">
                            <span class="text-muted">База даних:</span>
                            <span class="fw-semibold">PostgreSQL (Prod) / SQLite</span>
                        </li>
                        <li class="d-flex justify-content-between pb-2 border-bottom">
                            <span class="text-muted">Зареєстровано:</span>
                            <span class="fw-semibold">@Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                        </li>
                        <li class="d-flex justify-content-between">
                            <span class="text-muted">Статус акаунта:</span>
                            <span class="badge bg-success-subtle text-success">Активний</span>
                        </li>
                    </ul>
                </div>

                <div class="card p-4 surface-subtle border">
                    <div class="d-flex align-items-start gap-3">
                        <span class="icon-bubble icon-bubble-indigo mt-1">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                        </span>
                        <div>
                            <div class="fw-bold small mb-1">Безпека доступу</div>
                            <div class="text-muted small">
                                Для захисту облікових даних рекомендуємо використовувати надійний пароль довжиною не менше 8 символів.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- TAB 2: Upcoming Interviews & Schedule -->
    <div class="tab-pane fade" id="schedule" role="tabpanel" aria-labelledby="schedule-tab">
        <div class="card p-4">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
                <div>
                    <h2 class="h5 fw-bold mb-1">Мої заплановані співбесіди</h2>
                    <p class="text-muted small mb-0">Список призначених інтерв'ю з кандидатами, де ви є відповідальним або інтерв'юером.</p>
                </div>
                <a asp-controller="Interviews" asp-action="Calendar" class="btn btn-outline-primary btn-sm">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                    Відкрити календарний графік
                </a>
            </div>

            @if (Model.MyUpcomingInterviews.Count == 0)
            {
                <div class="empty-state py-5 text-center">
                    <div class="empty-state-icon mb-3 mx-auto">
                        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                    </div>
                    <h3 class="h6 fw-bold mb-1">У вас наразі немає призначених співбесід</h3>
                    <p class="text-muted small mb-3">Коли рекрутер призначить вам інтерв'ю, воно з'явиться тут та в календарі.</p>
                    <a asp-controller="Interviews" asp-action="Calendar" class="btn btn-primary btn-sm">Переглянути календар компанії</a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Дата та час</th>
                                <th>Кандидат</th>
                                <th>Вакансія</th>
                                <th>Тип зустрічі</th>
                                <th>Статус</th>
                                <th class="text-end">Дії</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var interview in Model.MyUpcomingInterviews)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold">@interview.InterviewDate.ToLocalTime().ToString("dd.MM.yyyy")</div>
                                        <div class="text-muted small font-monospace">@interview.InterviewDate.ToLocalTime().ToString("HH:mm")</div>
                                    </td>
                                    <td>
                                        <div class="fw-semibold">@(interview.Application?.Candidate?.FullName ?? "Не вказано")</div>
                                        <div class="text-muted small">@(interview.Application?.Candidate?.Email ?? "—")</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            @(interview.Application?.Vacancy?.Title ?? "Загальний розгляд")
                                        </span>
                                    </td>
                                    <td>
                                        <span class="@HrOptions.InterviewTypeBadge(interview.InterviewType)">
                                            @HrOptions.InterviewTypeLabel(interview.InterviewType)
                                        </span>
                                    </td>
                                    <td>
                                        <span class="@HrOptions.InterviewResultBadge(interview.Result)">
                                            @HrOptions.InterviewResultLabel(interview.Result)
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-controller="Interviews" asp-action="Details" asp-route-id="@interview.Id" class="btn btn-outline-secondary" title="Деталі співбесіди">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                                            </a>
                                            <a asp-controller="InterviewFeedbacks" asp-action="Create" asp-route-interviewId="@interview.Id" class="btn btn-outline-primary" title="Залишити відгук">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                                Відгук
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- TAB 3: My Feedbacks & Scores -->
    <div class="tab-pane fade" id="feedbacks" role="tabpanel" aria-labelledby="feedbacks-tab">
        <div class="card p-4">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
                <div>
                    <h2 class="h5 fw-bold mb-1">Мої оцінки та відгуки</h2>
                    <p class="text-muted small mb-0">Історія зворотного зв'язку, наданого вами після технічних та HR-співбесід.</p>
                </div>
                @if (User.IsInRole("Admin") || User.IsInRole("Recruiter") || User.IsInRole("Interviewer"))
                {
                    <a asp-controller="InterviewFeedbacks" asp-action="Create" class="btn btn-primary btn-sm">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                        Створити новий відгук
                    </a>
                }
            </div>

            @if (Model.MyRecentFeedbacks.Count == 0)
            {
                <div class="empty-state py-5 text-center">
                    <div class="empty-state-icon mb-3 mx-auto">
                        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                    </div>
                    <h3 class="h6 fw-bold mb-1">Ви ще не залишали оцінок та відгуків</h3>
                    <p class="text-muted small mb-3">Після проведення співбесіди ви зможете виставити оцінку (1-10) та зафіксувати свої рекомендації.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Дата</th>
                                <th>Кандидат / Вакансія</th>
                                <th>Оцінка</th>
                                <th>Рекомендація</th>
                                <th>Коментар</th>
                                <th class="text-end">Перегляд</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var fb in Model.MyRecentFeedbacks)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold">@fb.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</div>
                                        <div class="text-muted small">@fb.CreatedAt.ToLocalTime().ToString("HH:mm")</div>
                                    </td>
                                    <td>
                                        <div class="fw-semibold">@(fb.Interview?.Application?.Candidate?.FullName ?? "Кандидат")</div>
                                        <div class="text-muted small">@(fb.Interview?.Application?.Vacancy?.Title ?? "Вакансія")</div>
                                    </td>
                                    <td>
                                        <span class="badge @(fb.Score >= 8 ? "bg-success" : fb.Score >= 5 ? "bg-warning text-dark" : "bg-danger") px-2 py-1">
                                            @fb.Score / 10
                                        </span>
                                    </td>
                                    <td>
                                        <span class="@HrOptions.FeedbackRecommendationBadge(fb.Recommendation)">
                                            @HrOptions.FeedbackRecommendationLabel(fb.Recommendation)
                                        </span>
                                    </td>
                                    <td style="max-width: 320px;">
                                        <div class="text-truncate small" title="@fb.Comment">@fb.Comment</div>
                                    </td>
                                    <td class="text-end">
                                        <a asp-controller="InterviewFeedbacks" asp-action="Details" asp-route-id="@fb.Id" class="btn btn-outline-secondary btn-sm" title="Деталі відгуку">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- TAB 4: Security & Password -->
    <div class="tab-pane fade" id="security" role="tabpanel" aria-labelledby="security-tab">
        <div class="row g-4">
            <div class="col-lg-7">
                <div class="card p-4">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="icon-bubble icon-bubble-amber">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                        </span>
                        <div>
                            <h2 class="h5 fw-bold mb-0">Зміна пароля доступу</h2>
                            <p class="text-muted small mb-0">Введіть поточний пароль і задайте новий для захисту облікового запису.</p>
                        </div>
                    </div>

                    <form asp-action="Profile" method="post" novalidate id="securityForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="FullName" />
                        <input type="hidden" asp-for="Email" />
                        <input type="hidden" asp-for="Login" />
                        <input type="hidden" asp-for="Role" />
                        <input type="hidden" asp-for="AvatarUrl" />

                        <div class="mb-3">
                            <label asp-for="CurrentPassword" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <input asp-for="CurrentPassword" type="password" class="form-control" placeholder="••••••••" id="currentPasswordInput" autocomplete="current-password" />
                                <button class="btn btn-outline-secondary" type="button" onclick="togglePassVisibility('currentPasswordInput')">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                                </button>
                            </div>
                            <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="NewPassword" class="form-label fw-semibold"></label>
                                <div class="input-group">
                                    <input asp-for="NewPassword" type="password" class="form-control" placeholder="••••••••" id="newPasswordInput" autocomplete="new-password" />
                                    <button class="btn btn-outline-secondary" type="button" onclick="togglePassVisibility('newPasswordInput')">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                                    </button>
                                </div>
                                <span asp-validation-for="NewPassword" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="ConfirmNewPassword" class="form-label fw-semibold"></label>
                                <div class="input-group">
                                    <input asp-for="ConfirmNewPassword" type="password" class="form-control" placeholder="••••••••" id="confirmPasswordInput" autocomplete="new-password" />
                                    <button class="btn btn-outline-secondary" type="button" onclick="togglePassVisibility('confirmPasswordInput')">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                                    </button>
                                </div>
                                <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex align-items-center justify-content-end gap-2 pt-2 border-top">
                            <button type="submit" class="btn btn-warning px-4">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                                Оновити пароль
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="card p-4">
                    <h3 class="h6 fw-bold mb-3 d-flex align-items-center gap-2">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-primary"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                        Вимоги до пароля
                    </h3>
                    <ul class="list-unstyled mb-0 d-flex flex-column gap-2 small text-muted">
                        <li class="d-flex align-items-center gap-2">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-success"><polyline points="20 6 9 17 4 12"/></svg>
                            Мінімум 6 символів (рекомендовано від 8).
                        </li>
                        <li class="d-flex align-items-center gap-2">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-success"><polyline points="20 6 9 17 4 12"/></svg>
                            Використовуйте поєднання літер, цифр та спецсимволів.
                        </li>
                        <li class="d-flex align-items-center gap-2">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-success"><polyline points="20 6 9 17 4 12"/></svg>
                            Пароль хешується алгоритмом PBKDF2 з сіллю.
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePassVisibility(inputId) {
            const input = document.getElementById(inputId);
            if (input) {
                input.type = input.type === 'password' ? 'text' : 'password';
            }
        }

        // Live avatar preview on selecting a file
        const avatarFileInput = document.getElementById('avatarFileInput');
        if (avatarFileInput) {
            avatarFileInput.addEventListener('change', function(e) {
                const file = e.target.files && e.target.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function(event) {
                        const avatarPreview = document.getElementById('avatarPreview');
                        const avatarFallback = document.getElementById('avatarPreviewFallback');
                        const avatarSubPreview = document.getElementById('avatarSubPreview');
                        const avatarSubFallback = document.getElementById('avatarSubFallback');

                        if (avatarPreview) {
                            avatarPreview.src = event.target.result;
                            avatarPreview.classList.remove('d-none');
                            avatarPreview.style.setProperty('display', 'block', 'important');
                        }
                        if (avatarFallback) {
                            avatarFallback.classList.add('d-none');
                            avatarFallback.style.setProperty('display', 'none', 'important');
                        }
                        if (avatarSubPreview) {
                            avatarSubPreview.src = event.target.result;
                        } else if (avatarSubFallback) {
                            const newImg = document.createElement('img');
                            newImg.src = event.target.result;
                            newImg.className = 'w-100 h-100 rounded-circle';
                            newImg.style.objectFit = 'cover';
                            newImg.id = 'avatarSubPreview';
                            avatarSubFallback.parentNode.replaceChild(newImg, avatarSubFallback);
                        }
                    };
                    reader.readAsDataURL(file);
                }
            });
        }
    </script>
}
