@model HRReserveSystem.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Реєстрація";
}

<div class="auth-wrapper py-3 py-lg-5">
    <div class="row justify-content-center align-items-stretch g-4 g-xl-5">
        <div class="col-lg-5 d-none d-lg-flex flex-column justify-content-between">
            <div class="auth-showcase p-4 p-xl-5 h-100 d-flex flex-column justify-content-between">
                <div>
                    <div class="d-inline-flex align-items-center gap-2 auth-pill mb-4">
                        <span class="status-dot status-dot-blue"></span>
                        <span>Приєднання до команди найму</span>
                    </div>
                    <h1 class="h2 fw-bold tracking-tight mb-3">
                        Створіть робочий профіль у HR Reserve System
                    </h1>
                    <p class="text-muted mb-4 leading-relaxed">
                        Реєстрація займає менше хвилини. Після створення акаунту ви одразу отримаєте доступ до робочого простору відповідно до обраної ролі.
                    </p>

                    <div class="auth-feature-list d-flex flex-column gap-3 my-4">
                        <div class="auth-feature-card">
                            <div class="auth-feature-icon icon-blue">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg>
                            </div>
                            <div>
                                <div class="fw-semibold mb-1">Роль «Рекрутер»</div>
                                <div class="text-muted small">Ведення бази кандидатів, публікація вакансій, управління заявками, завантаження резюме та планування співбесід.</div>
                            </div>
                        </div>

                        <div class="auth-feature-card">
                            <div class="auth-feature-icon icon-amber">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                            </div>
                            <div>
                                <div class="fw-semibold mb-1">Роль «Інтерв'юер»</div>
                                <div class="text-muted small">Участь у співбесідах, надання структурованих фідбеків та детальна оцінка Soft Skills кандидатів.</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="p-3 rounded-3 surface-subtle border">
                    <div class="small text-muted">
                        <strong>Безпека та синхронізація:</strong> обліковий запис автоматично синхронізується з ASP.NET Core Identity із захищеним хешуванням пароля.
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-10 col-lg-7 col-xl-6">
            <div class="card auth-card border-0 h-100">
                <div class="card-body p-4 p-xl-5">
                    <div class="auth-tabs mb-4" role="tablist" aria-label="Перемикач авторизації">
                        <a class="auth-tab" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">
                            Вхід у систему
                        </a>
                        <a class="auth-tab active" asp-controller="Account" asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl">
                            Реєстрація
                        </a>
                    </div>

                    <div class="mb-4">
                        <h2 class="h3 fw-bold mb-1">Новий обліковий запис</h2>
                        <p class="text-muted small mb-0">Заповніть дані нижче для миттєвого доступу до системи.</p>
                    </div>

                    <form asp-action="Register" method="post" class="row g-3" novalidate>
                        <input type="hidden" asp-for="ReturnUrl" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small mb-2"></div>

                        <div class="col-12">
                            <label asp-for="FullName" class="form-label fw-medium">ПІБ (Повне ім'я)</label>
                            <input asp-for="FullName" class="form-control" placeholder="Наприклад: Ірина Мельник" autocomplete="name" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-medium">Електронна пошта</label>
                            <input asp-for="Email" class="form-control" type="email" placeholder="iryna.melnyk@company.ua" autocomplete="email" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Login" class="form-label fw-medium">Логін для входу</label>
                            <input asp-for="Login" class="form-control font-monospace" placeholder="iryna.melnyk" autocomplete="username" />
                            <span asp-validation-for="Login" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-medium d-block mb-2">Оберіть роль для вашого акаунту</label>
                            <div class="row g-2">
                                <div class="col-md-4">
                                    <label class="role-selector-card h-100">
                                        <input type="radio" asp-for="Role" value="Candidate" class="form-check-input" checked />
                                        <span class="role-selector-body">
                                            <span class="fw-semibold d-block text-emerald">Кандидат</span>
                                            <small class="text-muted">Особисте портфоліо, резюме, статус відбору та оцінки</small>
                                        </span>
                                    </label>
                                </div>
                                <div class="col-md-4">
                                    <label class="role-selector-card h-100">
                                        <input type="radio" asp-for="Role" value="Recruiter" class="form-check-input" />
                                        <span class="role-selector-body">
                                            <span class="fw-semibold d-block">Рекрутер</span>
                                            <small class="text-muted">Кандидати, вакансії, заявки та співбесіди</small>
                                        </span>
                                    </label>
                                </div>
                                <div class="col-md-4">
                                    <label class="role-selector-card h-100">
                                        <input type="radio" asp-for="Role" value="Interviewer" class="form-check-input" />
                                        <span class="role-selector-body">
                                            <span class="fw-semibold d-block">Інтерв'юер</span>
                                            <small class="text-muted">Оцінка знань, відгуки та матриця Soft Skills</small>
                                        </span>
                                    </label>
                                </div>
                            </div>
                            <span asp-validation-for="Role" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label fw-medium">Пароль</label>
                            <div class="password-field-group">
                                <input asp-for="Password" class="form-control pe-5" autocomplete="new-password" placeholder="Мінімум 6 символів" />
                                <button type="button" class="btn-password-toggle" data-password-toggle aria-label="Показати або приховати пароль">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label fw-medium">Підтвердження пароля</label>
                            <div class="password-field-group">
                                <input asp-for="ConfirmPassword" class="form-control pe-5" autocomplete="new-password" placeholder="Повторіть пароль" />
                                <button type="button" class="btn-password-toggle" data-password-toggle aria-label="Показати або приховати пароль">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                </button>
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <div class="col-12 pt-2">
                            <button type="submit" class="btn btn-primary btn-lg w-100 fw-semibold">
                                Зареєструватися та увійти
                            </button>
                        </div>

                        <div class="col-12 text-center pt-2">
                            <span class="text-muted small">Вже маєте обліковий запис?</span>
                            <a asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl" class="small fw-semibold text-decoration-none ms-1">Увійти в систему</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
