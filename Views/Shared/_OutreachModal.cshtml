<!-- Candidate Communication Outreach Modal -->
<div class="modal fade" id="outreachModal" tabindex="-1" aria-labelledby="outreachModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content bg-surface border">
            <div class="modal-header border-bottom py-3">
                <div>
                    <h2 class="modal-title h5 fw-bold mb-0" id="outreachModalLabel">Зв'язок із кандидатом</h2>
                    <div class="small text-muted" id="outreachCandidateSubtitle">Підготовка повідомлення</div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрити"></button>
            </div>

            <div class="modal-body p-4">
                <!-- Template Selection Pills -->
                <div class="d-flex flex-wrap gap-2 mb-3" role="tablist">
                    <button class="btn btn-sm btn-outline-primary active outreach-tab-btn" type="button" data-template-type="screening">
                        📞 HR-скринінг
                    </button>
                    <button class="btn btn-sm btn-outline-primary outreach-tab-btn" type="button" data-template-type="technical">
                        💻 Технічна співбесіда
                    </button>
                    <button class="btn btn-sm btn-outline-primary outreach-tab-btn" type="button" data-template-type="offer">
                        🎉 Оффер (Job Offer)
                    </button>
                    <button class="btn btn-sm btn-outline-primary outreach-tab-btn" type="button" data-template-type="rejection">
                        🤝 Тактовна відмова
                    </button>
                </div>

                <!-- Subject line preview -->
                <div class="mb-3">
                    <label class="form-label small fw-bold text-muted text-uppercase" style="font-size:0.75rem;">Тема листа</label>
                    <input type="text" id="outreachSubjectInput" class="form-control form-control-sm fw-medium" />
                </div>

                <!-- Message body preview & edit -->
                <div class="mb-3">
                    <div class="d-flex align-items-center justify-content-between mb-1">
                        <label class="form-label small fw-bold text-muted text-uppercase mb-0" style="font-size:0.75rem;">Текст повідомлення</label>
                        <span class="small text-muted" style="font-size:0.75rem;">Можна редагувати перед відправкою</span>
                    </div>
                    <textarea id="outreachBodyTextarea" class="form-control" rows="8" style="font-size: 0.88rem; line-height: 1.5; font-family: inherit;"></textarea>
                </div>
            </div>

            <div class="modal-footer border-top py-2 px-4 d-flex align-items-center justify-content-between bg-surface-muted">
                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Скасувати</button>
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-sm btn-outline-primary" id="outreachCopyBtn">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
                        <span id="outreachCopyBtnText">Скопіювати</span>
                    </button>
                    <a href="#" id="outreachTelegramBtn" target="_blank" class="btn btn-sm btn-outline-info">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
                        Telegram
                    </a>
                    <a href="#" id="outreachMailtoBtn" class="btn btn-sm btn-primary">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L1 7"/></svg>
                        Відкрити в пошті
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
