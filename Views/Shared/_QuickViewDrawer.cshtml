<!-- Candidate Quick-View Slide-over Drawer -->
<div class="offcanvas offcanvas-end quick-view-drawer" tabindex="-1" id="quickViewDrawer" aria-labelledby="quickViewDrawerLabel" style="width: min(520px, 92vw);">
    <div class="offcanvas-header border-bottom bg-surface py-3">
        <div class="d-flex align-items-center gap-3 min-w-0">
            <span class="profile-avatar profile-avatar-md flex-shrink-0" id="qvAvatarInitial" aria-hidden="true">К</span>
            <img src="" alt="" id="qvAvatarImg" class="profile-avatar profile-avatar-md flex-shrink-0 d-none" style="object-fit: cover;" />
            <div class="min-w-0">
                <h2 class="offcanvas-title h5 fw-bold mb-0 text-truncate" id="quickViewDrawerLabel">Кандидат</h2>
                <div class="small text-muted text-truncate" id="qvSubtitle">Завантаження...</div>
            </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Закрити"></button>
    </div>

    <div class="offcanvas-body p-0 d-flex flex-column" style="overflow-y: auto;">
        <!-- Quick stats bar -->
        <div class="p-3 bg-surface-muted border-bottom d-flex align-items-center justify-content-around text-center">
            <div>
                <small class="text-muted d-block" style="font-size:0.75rem;">Досвід</small>
                <strong id="qvExperience" class="fs-6">—</strong>
            </div>
            <div class="border-start ps-3">
                <small class="text-muted d-block" style="font-size:0.75rem;">Контакти</small>
                <strong id="qvPhoneStatus" class="fs-6 text-success">Є телефон</strong>
            </div>
            <div class="border-start ps-3">
                <small class="text-muted d-block" style="font-size:0.75rem;">Soft Skills</small>
                <strong id="qvSoftSkillScore" class="fs-6 text-primary">—</strong>
            </div>
        </div>

        <div class="p-3">
            <!-- Contact details -->
            <div class="card p-3 mb-3 bg-surface border">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="small fw-bold text-muted text-uppercase" style="font-size:0.72rem;">Контактні дані</span>
                    <button type="button" class="btn btn-xs btn-outline-secondary" id="qvCopyContactsBtn" title="Копіювати контакти">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
                        Копіювати
                    </button>
                </div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-muted"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L1 7"/></svg>
                    <a href="#" id="qvEmailLink" class="text-decoration-none fw-medium text-truncate">email@example.com</a>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-muted"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                    <span id="qvPhone" class="fw-medium text-truncate">+380...</span>
                </div>
            </div>

            <!-- Skills chips -->
            <div class="mb-3">
                <span class="small fw-bold text-muted text-uppercase d-block mb-2" style="font-size:0.72rem;">Стек технологій</span>
                <div id="qvSkillsList" class="d-flex flex-wrap gap-1">
                    <span class="badge-soft badge-soft-slate">Завантаження...</span>
                </div>
            </div>

            <!-- Resume preview / download -->
            <div class="card p-3 mb-3 bg-surface border" id="qvResumeCard">
                <div class="d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-2">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-danger"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>
                        <div>
                            <strong class="d-block text-truncate" style="font-size:0.85rem;" id="qvResumeTitle">Резюме кандидата</strong>
                            <span class="small text-muted" id="qvResumeSummary">Резюме прикріплено</span>
                        </div>
                    </div>
                    <a href="#" id="qvResumeDownloadBtn" class="btn btn-sm btn-outline-primary" target="_blank">
                        Завантажити
                    </a>
                </div>
            </div>

            <!-- Active applications -->
            <div class="mb-3">
                <span class="small fw-bold text-muted text-uppercase d-block mb-2" style="font-size:0.72rem;">Заявки на вакансії</span>
                <div id="qvApplicationsList" class="d-flex flex-column gap-2">
                    <!-- Populated via JS -->
                </div>
            </div>

            <!-- Scheduled Interviews -->
            <div class="mb-3">
                <span class="small fw-bold text-muted text-uppercase d-block mb-2" style="font-size:0.72rem;">Співбесіди</span>
                <div id="qvInterviewsList" class="d-flex flex-column gap-2">
                    <!-- Populated via JS -->
                </div>
            </div>

            <!-- Recruiter Internal Notes -->
            <div class="card p-3 bg-surface border mb-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="small fw-bold text-muted text-uppercase" style="font-size:0.72rem;">Внутрішні нотатки рекрутерів</span>
                    <span class="badge-soft badge-soft-emerald" style="font-size:0.68rem;">Команда</span>
                </div>
                <div class="input-group mb-2">
                    <input type="text" id="qvNewNoteInput" class="form-control form-control-sm" placeholder="Додати нотатку (очікування, враження, дзвінок)..." />
                    <button class="btn btn-sm btn-primary" type="button" id="qvSaveNoteBtn">Зберегти</button>
                </div>
                <div id="qvNotesTimeline" class="small text-muted mt-2" style="max-height: 180px; overflow-y: auto; white-space: pre-wrap; font-size: 0.82rem; line-height: 1.4;">
                    Немає додаткових коментарів.
                </div>
            </div>
        </div>
    </div>

    <div class="offcanvas-footer border-top p-3 bg-surface d-flex align-items-center justify-content-between gap-2">
        <a href="#" id="qvFullDetailsBtn" class="btn btn-sm btn-outline-secondary">
            Повний профіль
        </a>
        <button type="button" class="btn btn-sm btn-primary" id="qvOutreachTriggerBtn">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
            Зв'язатися
        </button>
    </div>
</div>
