@model IEnumerable<HRReserveSystem.Models.Application>

@{
    ViewData["Title"] = "Заявки (Пайплайн)";
    var currentStatus = ViewData["StatusFilter"] as string;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <span class="section-eyebrow">Воронка рекрутингу</span>
        <h1 class="h2 fw-bold mb-1">Заявки кандидатів <span class="badge-soft badge-soft-slate font-monospace ms-1">@Model.Count()</span></h1>
        <p class="text-muted mb-0">Відстеження етапів проходження кандидатів від первинного скринінгу до оффера.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <div class="btn-group" role="group" aria-label="Перемикач виду">
            <a asp-action="Index" class="btn btn-sm btn-primary active">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
                Таблиця
            </a>
            <a asp-action="Kanban" class="btn btn-sm btn-outline-secondary">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><rect width="6" height="14" x="3" y="5" rx="1"/><rect width="6" height="18" x="15" y="3" rx="1"/></svg>
                Канбан
            </a>
        </div>
        <a class="btn btn-sm btn-primary" asp-action="Create">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
            Створити заявку
        </a>
    </div>
</div>

<div class="pipeline-strip mb-4" role="navigation" aria-label="Фільтр за етапами пайплайну">
    <a class="pipeline-pill @(string.IsNullOrEmpty(currentStatus) ? "active" : "")" asp-action="Index">
        <span>Усі етапи</span>
    </a>
    @foreach (var status in HrOptions.ApplicationStatuses)
    {
        <a class="pipeline-pill @(currentStatus == status ? "active" : "")" asp-action="Index" asp-route-status="@status">
            <span>@HrOptions.ApplicationStatusLabel(status)</span>
        </a>
    }
</div>

<div class="card">
    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Кандидат</th>
                        <th>Вакансія</th>
                        <th>Поточний етап</th>
                        <th>Швидка зміна етапу</th>
                        <th>Коментар рекрутера</th>
                        <th>Подано</th>
                        <th class="text-end">Дії</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr class="clickable-row" data-row-link="@Url.Action("Details", new { id = item.Id })" tabindex="0">
                        <td class="fw-semibold">@item.Candidate?.FullName</td>
                        <td>@item.Vacancy?.Title</td>
                        <td>
                            <span class="@HrOptions.ApplicationStatusBadge(item.Status)">
                                @HrOptions.ApplicationStatusLabel(item.Status)
                            </span>
                        </td>
                        <td>
                            <form asp-action="UpdateStatus" method="post" class="d-inline-flex align-items-center gap-1">
                                <input type="hidden" name="id" value="@item.Id" />
                                <input type="hidden" name="returnStatusFilter" value="@currentStatus" />
                                <select name="status" class="form-select form-select-sm" style="min-width: 150px;" onchange="this.form.submit()" aria-label="Змінити етап заявки">
                                    @foreach (var st in HrOptions.ApplicationStatuses)
                                    {
                                        <option value="@st" selected="@(st == item.Status)">@HrOptions.ApplicationStatusLabel(st)</option>
                                    }
                                </select>
                            </form>
                        </td>
                        <td class="table-comment-cell text-muted small">@(string.IsNullOrWhiteSpace(item.RecruiterComment) ? "—" : item.RecruiterComment)</td>
                        <td class="font-monospace small text-muted">@item.AppliedAt.ToLocalTime().ToString("dd.MM.yyyy")</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@item.Id">Деталі</a>
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@item.Id">Редагувати</a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id">Видалити</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <h2 class="h5 fw-bold">Заявки на цьому етапі відсутні</h2>
            <p class="text-muted mb-3">Оберіть інший етап воронки або подайте кандидата на відкриту вакансію.</p>
            <a class="btn btn-primary" asp-action="Create"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14"/><path d="M5 12h14"/></svg> Створити заявку</a>
        </div>
    }
</div>
